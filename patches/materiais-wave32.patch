+++ b/crates/victory-gpu/src/shader_cache/adapter.rs
@@ -0,0 +1,71 @@
+use victory_shader::emit::{HostShader, StaticSampler, UserData};
+use victory_shader::{Container, FourCC, HwStage, RootType};
+
+/// The lane interval follows the four-byte size and the first 16 bytes of
+/// PSVRuntimeInfo0. A zero minimum and UINT_MAX maximum allow any width.
+fn permits_wave32(dxil: &[u8]) -> bool {
+    let Ok(c) = Container::parse(dxil) else { return false };
+    let Some(psv) = c.part(FourCC(*b"PSV0")) else { return false };
+    if psv.data.len() < 28 { return false; }
+    let word = |offset| u32::from_le_bytes(psv.data[offset..offset + 4].try_into().unwrap());
+    word(0) >= 24 && word(20) <= 32 && word(24) >= 32
+}
+
+// These pinned emitters use the same register-space ABI, but Cargo gives
+// each revision its own Rust types. Keep every root word and sampler.
+macro_rules! import_shader {
+    ($backend:ident, $shader:expr) => {{
+        use $backend::{HwStage as Stage, RootType as Root};
+        let source = $shader;
+        let stage = match source.stage {
+            Stage::Cs => HwStage::Cs,
+            Stage::Ms => HwStage::Ms,
+            Stage::Ps => HwStage::Ps,
+            Stage::Vs => HwStage::Vs,
+            _ => return Err("unsupported host shader stage".into()),
+        };
+        let user_data = source.user_data.into_iter().map(|word| UserData {
+            index: word.index, slot: word.slot, dword: word.dword,
+            root: match word.root {
+                Root::Constants => RootType::Constants,
+                Root::Descriptor => RootType::Descriptor,
+                Root::Table => RootType::Table,
+                Root::ImmediateSampler => RootType::ImmediateSampler,
+                Root::ResourceHeap => RootType::ResourceHeap,
+                Root::SamplerHeap => RootType::SamplerHeap,
+                Root::Other(value) => RootType::Other(value),
+            },
+        }).collect();
+        Ok(HostShader {
+            stage, user_data, dxil: source.dxil,
+            static_samplers: source.samplers.iter().copied().map(StaticSampler::from_words).collect(),
+            samplers: source.samplers, root_cbvs: source.root_cbvs, root_srvs: source.root_srvs,
+        })
+    }};
+}
+
+pub(super) fn for_wave32(container: &[u8], primary: Result<HostShader, String>) -> Result<HostShader, String> {
+    let first = match primary {
+        Ok(shader) if permits_wave32(&shader.dxil) => return Ok(shader),
+        Ok(_) => "translated DXIL requires a wave width unavailable on this adapter".to_owned(),
+        Err(reason) => reason,
+    };
+    use material_translator::emit::{Target, translate_for};
+    let target = Target { lanes_min: 32, lanes_max: 32 };
+    let second = match translate_for(container, target) {
+        Ok(shader) if !shader.stride_table && permits_wave32(&shader.dxil) => {
+            return import_shader!(material_translator, shader);
+        }
+        Ok(_) => "needs an additional stride binding or another wave width".to_owned(),
+        Err(error) => error.to_string(),
+    };
+    use wave_translator::emit::{TranslateOptions, Wave64Mode, translate_with};
+    let options = TranslateOptions { wave64: Wave64Mode::Wave32 };
+    match translate_with(container, options) {
+        Ok(shader) if shader.stage == wave_translator::HwStage::Cs && permits_wave32(&shader.dxil) => {
+            import_shader!(wave_translator, shader)
+        }
+        Ok(_) => Err(format!("{first}; material translator: {second}")),
+        Err(error) => Err(format!("{first}; material translator: {second}; split-wave compute: {error}")),
+    }
+}
