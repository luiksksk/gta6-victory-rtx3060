+        // Clearing slot 0 recycles its bounce slice so slot 1 reuses it.
+        // SAFETY: slot 0 is a valid 32-byte descriptor slot in `title_heap`.
+        unsafe { (base as *mut u8).write_bytes(0, 32) };
