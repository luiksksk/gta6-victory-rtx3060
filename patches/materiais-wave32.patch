+    struct ExtendedHeapDesc {
+        desc: HeapDesc,
+        addr: u64,
+        size: u64,
+    }
+
+    fn make_shader_heap(count: u32) -> (This, u64) {
+        let ext = ExtendedHeapDesc {
+            desc: HeapDesc {
+                kind: 0,
+                count,
+                flags: 1,
+                nodes: 0,
+            },
+            addr: 0,
+            size: 0,
+        };
+        let mut out = std::ptr::null();
+        assert_eq!(
+            create_heap(std::ptr::null(), &ext.desc, &HEAP_IID, &mut out),
