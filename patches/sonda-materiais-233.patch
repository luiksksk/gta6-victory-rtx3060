+/// A successful MS draw can modify several MRTs. Keep both grid copies
+/// until the fence for the submission that executed this list is complete.
+pub(crate) struct PixelPair {
+    resource: usize,
+    slot: usize,
+    stages: String,
+    before: ID3D12Resource,
+    after: ID3D12Resource,
+}
+
+pub(crate) type Grid = (usize, usize, ID3D12Resource, ID3D12Resource);
+
+pub(crate) fn before_mesh(list: &crate::host::HostList, targets: &[usize]) -> Vec<Grid> {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var_os("VICTORY_PIXEL_GRID").is_some()) { return Vec::new(); }
+    let frame = PRESENTED_SCENE_FRAMES.load(Ordering::Relaxed);
+    if !matches!(frame, 4 | 12 | 24 | 36 | 48) { return Vec::new(); }
+    static BUDGET: std::sync::Mutex<(u64, usize)> = std::sync::Mutex::new((0, 0));
+    let Some(host) = crate::host::host() else { return Vec::new() };
+    let mut copies = Vec::new();
+    for (slot, &resource) in targets.iter().take(3).enumerate() {
+        let Some(texture) = crate::resource::host_resource(resource as crate::object::This) else { continue };
+        // Only subresource zero of these single-subresource scene targets.
+        let desc = unsafe { texture.GetDesc() };
+        if (desc.Width, desc.Height, desc.MipLevels, desc.DepthOrArraySize, desc.SampleDesc.Count) != (2560, 1440, 1, 1, 1)
+            || !matches!(desc.Format.0, 27..=29) { continue; }
+        let mut budget = BUDGET.lock().unwrap_or_else(|e| e.into_inner());
+        if budget.0 != frame { *budget = (frame, 0); }
+        if budget.1 >= 240 { break; }
+        budget.1 += 1;
+        drop(budget);
+        if let Some(before) = sample_rtv(&host.device, &list.list, texture) {
+            copies.push((resource, slot, texture.clone(), before));
+        }
+    }
+    copies
+}
+
+fn sample_rtv(device: &ID3D12Device, list: &ID3D12GraphicsCommandList, texture: &ID3D12Resource) -> Option<ID3D12Resource> {
+    let rt = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    let src = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    // prepare_for set RENDER_TARGET. Restore that same state before returning.
+    unsafe { list.ResourceBarrier(&[crate::host::transition(texture, rt, src)]) };
+    let read = probe(device, list, texture);
+    unsafe { list.ResourceBarrier(&[crate::host::transition(texture, src, rt)]) };
+    read
+}
+
+pub(crate) fn after_mesh(list: &crate::host::HostList, grids: Vec<Grid>, stages: String) {
+    let Some(host) = crate::host::host() else { return };
+    let mut pairs = list.pixel_pairs.lock().unwrap_or_else(|e| e.into_inner());
+    for (resource, slot, texture, before) in grids {
+        let after = sample_rtv(&host.device, &list.list, &texture);
+        // Retain a successful first copy even when the second allocation fails.
+        if let Some(after) = after {
+            pairs.push(PixelPair {resource, slot, stages: stages.clone(), before, after});
+        } else {
+            list.keep_grid(before);
+        }
+    }
+}
+
+impl PixelPair {
+    pub(crate) fn report(&self, fence: u64, list_index: usize, draw_sample: usize) {
+        fn words(buffer: &ID3D12Resource) -> Option<Vec<u32>> {
+            let mut ptr = std::ptr::null_mut();
+            unsafe {
+                buffer.Map(0, None, Some(&mut ptr)).ok()?;
+                let values = (0..GRID*GRID).map(|i| ptr.cast::<u8>().add(i as usize * SLOT as usize).cast::<u32>().read_unaligned()).collect();
+                buffer.Unmap(0, None);
+                Some(values)
+            }
+        }
+        if let (Some(before), Some(after)) = (words(&self.before), words(&self.after)) {
+            tracing::info!(fence, list_index, draw_sample, slot = self.slot, resource = format_args!("{:#x}", self.resource),
+                stages = %self.stages, before = ?before, after = ?after, "pass pixel grids");
+        }
+    }
+}
