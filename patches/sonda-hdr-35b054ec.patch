diff --git a/crates/victory-gpu/src/performance.rs b/crates/victory-gpu/src/performance.rs
new file mode 100644
index 0000000..c51a77d
--- /dev/null
+++ b/crates/victory-gpu/src/performance.rs
@@ -0,0 +1,80 @@
+//! Optional cumulative measurements sampled immediately after DXGI Present.
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_PERF").is_ok_and(|v| v == "1"))
+}
+
+/// Completed calls, failed calls, and summed wall microseconds across callers.
+/// Worker preparation includes the driver and translation calls inside it.
+pub(crate) struct Timing {
+    calls: AtomicU64,
+    failures: AtomicU64,
+    microseconds: AtomicU64,
+}
+
+impl Timing {
+    const fn new() -> Self {
+        Self {
+            calls: AtomicU64::new(0),
+            failures: AtomicU64::new(0),
+            microseconds: AtomicU64::new(0),
+        }
+    }
+
+    pub(crate) fn measure<T>(&self, run: impl FnOnce() -> T, ok: impl FnOnce(&T) -> bool) -> T {
+        if !enabled() {
+            return run();
+        }
+        let start = Instant::now();
+        let result = run();
+        self.microseconds.fetch_add(start.elapsed().as_micros() as u64, Relaxed);
+        if !ok(&result) {
+            self.failures.fetch_add(1, Relaxed);
+        }
+        self.calls.fetch_add(1, Relaxed);
+        result
+    }
+
+    fn counters(&self) -> [u64; 3] {
+        [self.calls.load(Relaxed), self.failures.load(Relaxed), self.microseconds.load(Relaxed)]
+    }
+}
+
+pub(crate) static WORKER: Timing = Timing::new();
+pub(crate) static TRANSLATE: Timing = Timing::new();
+pub(crate) static PSO_CREATE: Timing = Timing::new();
+pub(crate) static PSO_LOAD: Timing = Timing::new();
+
+/// One requested command with no host pipeline, including ExecuteIndirect calls.
+/// An indirect argument buffer may describe multiple draws.
+pub(crate) enum Missing {
+    Draw,
+    Mesh,
+    Compute,
+}
+
+static MISSING: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+
+pub(crate) fn missing(kind: Missing) {
+    if enabled() {
+        MISSING[kind as usize].fetch_add(1, Relaxed);
+    }
+}
+
+pub(crate) fn present(frame: u64, hresult: i32) {
+    if enabled() {
+        let (shader_hits, shader_misses) = crate::shader_cache::counts();
+        tracing::info!(
+            target: "victory_gpu::performance",
+            frame, hresult, shader_hits, shader_misses,
+            worker = ?WORKER.counters(), translate = ?TRANSLATE.counters(),
+            pso_create = ?PSO_CREATE.counters(), pso_load = ?PSO_LOAD.counters(),
+            missing_draw = MISSING[0].load(Relaxed), missing_mesh = MISSING[1].load(Relaxed),
+            missing_compute = MISSING[2].load(Relaxed), "post present"
+        );
+    }
+}
