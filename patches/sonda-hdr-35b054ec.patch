+}
+
+// A depth/stencil plane must be copied as a whole. Limit this deliberately
+// separate path to two surfaces and retain both depth snapshots through the fence.
+static DEPTH_SEEN: OnceLock<Mutex<HashSet<usize>>> = OnceLock::new();
+
+fn depth_target(
+    list: &HostList,
+    b: &Binding,
+) -> Option<(Arc<crate::resource::HostTexture>, usize, u32, u32)> {
+    if !b.single_view || !b.depth {
+        return None;
+    }
+    let copy = b.copy.as_ref()?.clone();
+    // SAFETY: GetDesc reads the live, reference-counted resource.
+    let desc = unsafe { copy.texture.GetDesc() };
+    if desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D
+        || desc.DepthOrArraySize != 1
+        || desc.SampleDesc.Count != 1
+        || !(320..=2560).contains(&desc.Width)
+        || desc.Height > 1440
+        || !(matches!(desc.Format.0,19..=22|39..=41|44..=46|53|55|56))
+    {
+        return None;
+    }
+    let state = list.scene_state(&copy)?;
+    let mut seen = DEPTH_SEEN
+        .get_or_init(Mutex::default)
+        .lock()
+        .unwrap_or_else(|e| e.into_inner());
+    if seen.len() >= 2 || !seen.insert(copy.texture.as_raw() as usize) {
+        return None;
+    }
+    Some((copy, b.id, b.view_format, state))
+}
+
+impl DepthRead {
+    fn record(
+        list: &HostList,
+        copy: &crate::resource::HostTexture,
+        id: usize,
+        view: u32,
+        state: u32,
+        before: bool,
+    ) -> Option<Self> {
+        let host = crate::host::host()?;
+        let state = D3D12_RESOURCE_STATES(state as i32);
+        let copy_src = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        // SAFETY: state belongs to this list. The whole plane is copied, as
+        // required for depth/stencil. The original state is restored even if
+        // the readback buffer allocation fails.
+        unsafe {
+            if state != copy_src {
+                list.list.ResourceBarrier(&[crate::host::transition(
+                    &copy.texture,
+                    state,
+                    copy_src,
+                )]);
+            }
+            let read = crate::capture::read_back(&host.device, &list.list, &copy.texture);
+            if state != copy_src {
+                list.list.ResourceBarrier(&[crate::host::transition(
+                    &copy.texture,
+                    copy_src,
+                    state,
+                )]);
+            }
+            let (back, footprint) = read?;
+            Some(Self {
+                back,
+                footprint,
+                host: copy.texture.as_raw() as usize,
+                id,
+                native: copy.texture.GetDesc().Format.0,
+                view,
+                before,
+            })
+        }
+    }
+
+    fn report(&self, frame: u64, submission: u64, list_index: usize, command: usize) {
+        let f = self.footprint.Footprint;
+        // Use the copied plane's actual format, which can differ from the
+        // resource (e.g. format 39 R32_TYPELESS for depth/stencil format 19).
+        let bytes: usize = match f.Format.0 {
+            19..=22 => 8,
+            39..=41 | 44..=47 => 4,
+            53..=59 => 2,
+            _ => return,
+        };
+        let mut data = std::ptr::null_mut();
+        // SAFETY: full copy completed. Only the selected x/y words are read,
+        // their bounds use the actual row pitch and the allocated buffer size.
+        unsafe {
+            let size = self.back.GetDesc().Width as usize;
+            let range = D3D12_RANGE {
+                Begin: 0,
+                End: size,
+            };
+            if self.back.Map(0, Some(&range), Some(&mut data)).is_err() || data.is_null() {
+                return;
+            }
+            for (x, y) in POINTS {
+                let x = x * f.Width / 1280;
+                let y = y * f.Height / 720;
+                let offset = self.footprint.Offset as usize
+                    + y as usize * f.RowPitch as usize
+                    + x as usize * bytes;
+                if offset + bytes > size {
+                    continue;
+                }
+                let pixel = std::slice::from_raw_parts(data.cast::<u8>().add(offset), bytes);
+                let hex = pixel.iter().map(|b| format!("{b:02x}")).collect::<String>();
+                tracing::info!(frame,submission,list_index,command,before=self.before,id=format_args!("{:#x}",self.id),
+                    host=format_args!("{:#x}",self.host),native=self.native,footprint=f.Format.0,view=self.view,x,y,raw=%hex,"scene depth plane zero");
+            }
+            self.back.Unmap(0, Some(&D3D12_RANGE { Begin: 0, End: 0 }));
+        }
+    }
+}
+
+fn readback(size: u64) -> Option<ID3D12Resource> {
+    let host = crate::host::host()?;
+    let heap = D3D12_HEAP_PROPERTIES {
+        Type: D3D12_HEAP_TYPE_READBACK,
+        ..Default::default()
+    };
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: size,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        ..Default::default()
+    };
+    let mut buffer = None;
+    // SAFETY: a live device and valid output pointer to an owned COM handle.
+    unsafe {
+        host.device
+            .CreateCommittedResource(
+                &heap,
+                D3D12_HEAP_FLAG_NONE,
+                &desc,
+                D3D12_RESOURCE_STATE_COPY_DEST,
+                None,
+                &mut buffer,
+            )
+            .ok()?;
+    }
+    buffer
+}
+
+fn texture(list: &HostList, b: &Binding, detail: &mut String) -> Option<Texture> {
+    let _ = write!(
+        detail,
+        " {}={:#x}:guest{:?}:v{}:mip0_2d={}",
+        b.label, b.id, b.guest_format, b.view_format, b.single_view
+    );
+    let Some(copy) = b.copy.clone() else {
+        let _ = write!(
+            detail,
+            ":no-host-texture:mem{:#x}:sub{}",
+            b.title_memory, b.subresource
+        );
+        return None;
+    };
+    // SAFETY: the reference-counted owner lives across recording and submission.
+    let d = unsafe { copy.texture.GetDesc() };
+    let _ = write!(
+        detail,
+        ":h{:p}:{}x{}:f{}:mem{:#x}:sub{}",
+        copy.texture.as_raw(),
+        d.Width,
+        d.Height,
+        d.Format.0,
+        b.title_memory,
+        b.subresource
+    );
+    if !b.single_view
+        || b.depth
+        || d.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D
+        || d.DepthOrArraySize != 1
+        || d.SampleDesc.Count != 1
+        || d.Width == 0
+        || d.Height == 0
+        || d.Flags.contains(D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
+    {
+        return None;
+    }
+    let bytes = match d.Format.0 {
+        1..=4 => 16,
+        9..=18 => 8,
+        23..=43 | 67 | 87..=93 => 4,
+        48..=59 => 2,
+        60..=65 => 1,
+        _ => return None,
+    };
+    let state = list.scene_state(&copy)?;
+    Some(Texture {
+        copy,
+        format: d.Format,
+        view_format: b.view_format,
+        id: b.id,
+        width: u32::try_from(d.Width).ok()?,
+        height: d.Height,
+        bytes,
+        output: b.output,
+        state,
+    })
+}
+
+fn descriptors(
+    state: &State,
+    compute: bool,
+    p: &crate::pipeline::host::HostPipeline,
+    detail: &mut String,
+) -> Vec<Binding> {
+    let mut bindings = if compute {
+        Vec::new()
+    } else {
+        state.scene_attachments.clone()
+    };
+    for stage in &p.stages {
+        for u in &stage.translated().used {
+            if !matches!(u.kind, ResourceType::Srv | ResourceType::Uav) {
+                continue;
+            }
+            let label = format!(
+                "{}.{:?}.s{}+{}dw",
+                stage.shader.hash, u.kind, u.slot, u.table_offset_dwords
+            );
+            let Some(root) = state.roots_ref(compute).get(u.slot as usize) else {
+                let _ = write!(detail, " {label}=unbound-root");
+                continue;
+            };
+            let (RootType::Table, Root::Table(base)) = (u.root, root) else {
+                let _ = write!(detail, " {label}={root:?}");
+                continue;
+            };
+            let Some(handle) = base
+                .checked_add(u64::from(u.table_offset_dwords) * 4)
+                .filter(|h| {
+                    state
+                        .heap_of(*base)
+                        .is_some_and(|heap| heap.index(*h).is_some())
+                })
+            else {
+                let _ = write!(detail, " {label}=outside-heap");
+                continue;
+            };
+            let Some(v) = crate::descriptor::view(handle) else {
+                let _ = write!(detail, " {label}=no-descriptor");
+                continue;
+            };
+            let (id, d, output) = match v {
+                View::Shader(id, d) => (id, d, false),
+                View::Unordered(id, _, d) => (id, d, true),
+                View::Placed(uav, r, d) => {
+                    let address = u64::from(d[10]) | u64::from(d[11]) << 32;
+                    let _ = write!(detail, " {label}=placed@{address:#x}:dim{}:f{}", r[0], r[8]);
+                    let Some(id) = crate::resource::scene_placed_texture(address, &r) else {
+                        continue;
+                    };
+                    (id, d[..10].try_into().ok(), uav)
+                }
+                _ => {
+                    let _ = write!(detail, " {label}=other-view");
+                    continue;
+                }
+            };
+            let (single_view, subresource) = shader_view(d.as_ref(), output);
+            bindings.push(Binding {
+                label,
+                id,
+                guest_format: crate::resource::scene_format(id as This),
+                title_memory: title_memory(id as This),
+                subresource,
+                copy: crate::resource::host_copy(id as This),
+                view_format: d.as_ref().map_or(0, |v| v[0]),
+                single_view,
+                output,
+                depth: false,
+            });
+        }
+    }
+    bindings
+}
+
+pub(crate) fn write_event(list: &HostList, dst: This, detail: impl FnOnce() -> String) {
+    if !active() || !matches!(crate::resource::scene_format(dst), Some(10 | 24 | 28)) {
+        return;
+    }
+    let host = crate::resource::host_resource(dst).map(|r| r.as_raw());
+    let detail = format!("{} dst={dst:p} host={host:?} mem={:#x}", detail(), title_memory(dst));
+    list.scene_events.lock().unwrap_or_else(|e| e.into_inner()).push(Event {
+        frame: crate::queue::presented()+1, record_present: PRESENTS.load(Relaxed), detail,
+        back: None, samples: Vec::new(), depth_reads: Vec::new(), argument_bytes: 0,
+    });
+}
+
+pub(super) fn draw_targets(state: &State, list: &HostList, op: &str) {
+    if active() {
+        for b in &state.scene_attachments {
+            if b.output && matches!(b.guest_format, Some(10 | 24 | 28)) {
+                write_event(list, b.id as This, || format!("{op} pso={:#x} {}", state.pipeline,b.label));
+            }
+        }
+    }
+}
+
+pub(super) fn begin(state: &State, list: &HostList, compute: bool, op: &str) -> Option<Probe> {
+    let record_present = window()?;
+    let p = crate::pipeline::host_pipeline(state.pipeline as This)?;
+    if !compute { draw_targets(state, list, op); }
+    if compute {
+        let mut detail = String::new();
+        for b in descriptors(state, true, p, &mut detail) {
+            if b.output && matches!(b.guest_format, Some(10 | 24 | 28)) {
+                write_event(list, b.id as This, || format!("{op} {} {}", p.name, b.label));
+            }
+        }
+    }
+    let pass = PASSES.iter().position(|hash| p.name.contains(hash))?;
+    // The transfer shader runs on different targets in each frame.
+    let destination = if matches!(PASSES[pass], PRODUCER | PREVIOUS_PRODUCER) {
+        state.scene_attachments.iter().find(|b| b.output)?.id
+    } else {
+        0
+    };
+    let take = SEEN.get_or_init(Mutex::default)
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert((record_present, pass, destination));
+    if !take {
+        return None;
+    }
+    let mut detail = format!("{op} guestPSO={:#x} {}", state.pipeline, p.name);
+    let mut textures: Vec<Texture> = Vec::new();
+    let mut compute_depth = None;
+    for mut binding in descriptors(state, compute, p, &mut detail) {
+        if compute && binding.view_format == 21 && binding.guest_format == Some(19) && compute_depth.is_none() {
+            binding.depth = true;
+            compute_depth = depth_target(list, &binding);
+        }
+        if let Some(t) = texture(list, &binding, &mut detail)
+            && (t.width >= 320 || t.width <= 8)
+        // scene/lighting or exposure scalars
+        {
+            if let Some(already) = textures.iter_mut().find(|old| {
+                let effective = |item: &Texture| {
+                    if item.view_format == 0 {
+                        item.format.0 as u32
+                    } else {
+                        item.view_format
+                    }
+                };
+                Arc::ptr_eq(&old.copy, &t.copy) && effective(old) == effective(&t)
+            }) {
+                already.output |= t.output;
+            } else {
+                textures.push(t);
+            }
+        }
+    }
+    let depth = if !textures.is_empty() && !compute {
+        state
+            .scene_attachments
+            .iter()
+            .find_map(|b| depth_target(list, b))
+    } else {
+        compute_depth
+    };
+    // Keep both sides of writable resources before adding other inputs when
+    // many descriptors are bound. Uncopied bindings remain in the transcript.
+    textures.sort_by_key(|t| !t.output);
+    textures.truncate(20);
+    let slots = textures
+        .iter()
+        .map(|t| 1 + usize::from(t.output))
+        .sum::<usize>()
+        * POINTS.len();
+    let back = if slots == 0 {
+        None
+    } else {
+        readback(slots as u64 * STEP)
+    };
+    let mut probe = Probe {
+        event: Event {
+            frame: crate::queue::presented() + 1,
+            record_present,
+            detail,
+            back,
+            samples: Vec::new(),
+            depth_reads: Vec::new(),
+            argument_bytes: 0,
+        },
+        textures,
+        depth,
+    };
+    probe.record(list, true);
+    Some(probe)
+}
+
+impl Probe {
+    fn record(&mut self, list: &HostList, before: bool) {
+        if let Some((copy, id, view, state)) = &self.depth
+            && let Some(read) = DepthRead::record(list, copy, *id, *view, *state, before)
+        {
+            self.event.depth_reads.push(read);
+        }
+        let Some(back) = self.event.back.as_ref() else {
+            return;
+        };
+        for t in self.textures.iter().filter(|t| before || t.output) {
+            let state = D3D12_RESOURCE_STATES(t.state as i32);
+            let copy = D3D12_RESOURCE_STATE_COPY_SOURCE;
+            // SAFETY: both owners are live, the current state comes from this specific
+            // list after bind/prepare. We restore it before any title command and
+            // never touch an MSAA, depth/stencil or block-compressed subresource.
+            unsafe {
+                if state != copy {
+                    list.list.ResourceBarrier(&[crate::host::transition(
+                        &t.copy.texture,
+                        state,
+                        copy,
+                    )]);
+                }
+                for (x, y) in POINTS {
+                    let xy = (
+                        (u64::from(x) * u64::from(t.width) / 1280) as u32,
+                        (u64::from(y) * u64::from(t.height) / 720) as u32,
+                    );
+                    let ofs = self.event.samples.len() as u64 * STEP;
+                    let from = D3D12_TEXTURE_COPY_LOCATION {
+                        pResource: std::mem::transmute_copy(&t.copy.texture),
+                        Type: D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX,
+                        Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+                            SubresourceIndex: 0,
+                        },
+                    };
+                    let to = D3D12_TEXTURE_COPY_LOCATION {
+                        pResource: std::mem::transmute_copy(back),
+                        Type: D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+                        Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+                            PlacedFootprint: D3D12_PLACED_SUBRESOURCE_FOOTPRINT {
+                                Offset: ofs,
+                                Footprint: D3D12_SUBRESOURCE_FOOTPRINT {
+                                    Format: t.format,
+                                    Width: 1,
+                                    Height: 1,
+                                    Depth: 1,
+                                    RowPitch: 256,
+                                },
+                            },
+                        },
+                    };
+                    let pixel = D3D12_BOX {
+                        left: xy.0,
+                        top: xy.1,
+                        front: 0,
+                        right: xy.0 + 1,
+                        bottom: xy.1 + 1,
+                        back: 1,
+                    };
+                    list.list
+                        .CopyTextureRegion(&to, 0, 0, 0, &from, Some(&pixel));
+                    self.event.samples.push(Sample {
+                        before,
+                        id: t.id,
+                        host: t.copy.texture.as_raw() as usize,
+                        format: t.format.0 as u32,
+                        view_format: t.view_format,
+                        offset: ofs as usize,
+                        bytes: t.bytes,
+                        xy,
+                    });
+                }
+                if state != copy {
+                    list.list.ResourceBarrier(&[crate::host::transition(
+                        &t.copy.texture,
+                        copy,
+                        state,
+                    )]);
+                }
+            }
+        }
+    }
+}
+
+pub(super) fn end(list: &HostList, probe: Option<Probe>) {
+    let Some(mut probe) = probe else {
+        return;
+    };
+    probe.record(list, false);
+    list.scene_events
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .push(probe.event);
+}
+
+/// Buffer reads bracket the host clamp and restore the list's tracked state.
+pub(super) fn argument_snapshot(
+    list: &HostList, source: &ID3D12Resource, address: u64, offset: u64, bytes: u64,
+    state: D3D12_RESOURCE_STATES, detail: String,
+) {
+    let Some(record_present) = window() else { return };
+    let bytes = bytes.min(4096);
+    if bytes == 0 { return }
+    let Some(back) = readback(bytes) else { return };
+    unsafe {
+        list.list.ResourceBarrier(&[crate::host::transition(source, state, D3D12_RESOURCE_STATE_COPY_SOURCE)]);
+        list.list.CopyBufferRegion(&back, 0, source, offset, bytes);
+        list.list.ResourceBarrier(&[crate::host::transition(source, D3D12_RESOURCE_STATE_COPY_SOURCE, state)]);
+    }
+    list.scene_events.lock().unwrap_or_else(|e| e.into_inner()).push(Event {
+        frame: crate::queue::presented()+1, record_present,
+        detail: format!("indirect-args {detail} guest={address:#x} host={:?} offset={offset} bytes={bytes}",source.as_raw()),
+        back: Some(back), samples: Vec::new(), depth_reads: Vec::new(), argument_bytes: bytes as usize,
+    });
+}
+
+pub(crate) fn completed(list: &HostList, submission: u64, list_index: usize) {
+    let events = list.scene_events.lock().unwrap_or_else(|e| e.into_inner());
+    for (command, event) in events.iter().enumerate() {
+        tracing::info!(frame=event.frame,record_present=event.record_present,submission,list_index,command,detail=%event.detail,"scene executed bindings");
+        for read in &event.depth_reads {
+            read.report(event.frame, submission, list_index, command);
+        }
+        let Some(back) = event.back.as_ref() else {
+            continue;
+        };
+        let mut ptr = std::ptr::null_mut();
+        let range = D3D12_RANGE {
+            Begin: 0,
+            End: event.samples.last().map_or(event.argument_bytes, |s| s.offset + s.bytes),
+        };
+        // SAFETY: the caller established successful device status and a completed
+        // fence. Every read is limited to the exact byte width of its format.
+        unsafe {
+            if back.Map(0, Some(&range), Some(&mut ptr)).is_err() || ptr.is_null() {
+                continue;
+            }
+            if event.argument_bytes > 0 {
+                let words = std::slice::from_raw_parts(ptr.cast::<u32>(), event.argument_bytes / 4);
+                tracing::info!(submission, list_index, command, ?words, "scene indirect arguments");
+            }
+            for s in &event.samples {
+                let pixel = std::slice::from_raw_parts(ptr.cast::<u8>().add(s.offset), s.bytes);
+                let mut hex = String::with_capacity(s.bytes * 2);
+                for byte in pixel {
+                    let _ = write!(hex, "{byte:02x}");
+                }
+                tracing::info!(frame=event.frame,submission,list_index,command,before=s.before,id=format_args!("{:#x}",s.id),
+                    host=format_args!("{:#x}",s.host),native=s.format,view=s.view_format,x=s.xy.0,y=s.xy.1,raw=%hex,"scene texel");
+            }
+            back.Unmap(0, Some(&D3D12_RANGE { Begin: 0, End: 0 }));
+        }
+    }
+}
