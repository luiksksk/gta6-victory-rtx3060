+//! On-demand texture lineage bounded by successful native Presents.
+//! Record reads before each selected command and writes immediately afterwards,
+//! on the same command list. Results are published only after the submission fence.
+use super::{Root, State};
+use crate::descriptor::View;
+use crate::host::HostList;
+use crate::object::This;
+use std::collections::HashSet;
+use std::fmt::Write;
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{Arc, Mutex, OnceLock};
+use victory_shader::{ResourceType, RootType};
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+use windows::core::Interface;
+
+static TRIGGER: OnceLock<Option<PathBuf>> = OnceLock::new();
+static PRESENTS: AtomicU64 = AtomicU64::new(0);
+static ARMED_AT: AtomicU64 = AtomicU64::new(0);
+static SEEN: OnceLock<Mutex<HashSet<(u64, usize, usize)>>> = OnceLock::new();
+const WINDOW: u64 = 8;
+const PRODUCER: &str = "5510a9fd27ceb4b1";
+const PREVIOUS_PRODUCER: &str = "43b4c00d725ac9c7";
+pub(super) const INDIRECT_HDR: &str = "731a39171b568298";
+const PASSES: [&str; 9] = [
+    "df11dcd012cd7382",
+    "5970ee6dbc47ec61",
+    "4f4ec7b16673362f",
+    "a78d088fa55aa495",
+    PRODUCER,
+    PREVIOUS_PRODUCER,
+    INDIRECT_HDR,
+    "813a7ead7f09ebd7",
+    "edc1cad8ffb79bc9",
+];
+const POINTS: [(u32, u32); 5] = [(120, 195), (120, 197), (120, 207), (385, 213), (640, 360)];
+const STEP: u64 = D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT as u64;
+
+pub(crate) fn enabled() -> bool {
+    TRIGGER
+        .get_or_init(|| std::env::var_os("VICTORY_SCENE_TRIGGER").map(PathBuf::from))
+        .is_some()
+}
+
+pub(crate) fn ever_armed() -> bool {
+    ARMED_AT.load(Relaxed) != 0
+}
+
+fn window() -> Option<u64> {
+    let armed = ARMED_AT.load(Relaxed);
+    let presents = PRESENTS.load(Relaxed);
+    (armed != 0 && presents.saturating_sub(armed) < WINDOW).then_some(presents)
+}
+
+pub(crate) fn active() -> bool {
+    window().is_some()
+}
+
+pub(crate) fn present(
+    frame: u64,
+    hresult: i32,
+    texture: &ID3D12Resource,
+    back: &ID3D12Resource,
+    index: u32,
+) {
+    if !enabled() {
+        return;
+    }
+    if active() {
+        tracing::info!(frame, hresult, index, source = ?texture.as_raw(), backbuffer = ?back.as_raw(),
+            "scene native Present returned");
+    }
+    if hresult == 0 {
+        let present = PRESENTS.fetch_add(1, Relaxed) + 1;
+        if !ever_armed()
+            && let Some(path) = TRIGGER.get().and_then(Option::as_ref)
+            && path.is_file()
+        {
+            ARMED_AT.store(present, Relaxed);
+            tracing::info!(frame, present, window = WINDOW, ?path, "scene probe armed after native Present");
+        }
+    }
+}
+
+#[derive(Clone)]
+pub(super) struct Binding {
+    label: String,
+    id: usize,
+    view_format: u32,
+    guest_format: Option<u32>,
+    copy: Option<Arc<crate::resource::HostTexture>>,
+    title_memory: usize,
+    subresource: String,
+    // A single 2D mip-zero plane-zero view is unambiguous. Other views
+    // still appear in the lineage and are marked as ineligible for copying.
+    single_view: bool,
+    output: bool,
+    depth: bool,
+}
+
+fn title_memory(id: This) -> usize {
+    crate::resource::texture_memory(id).map_or(0, |(base, _)| base as usize)
+}
+
+fn shader_view(words: Option<&[u32; 10]>, output: bool) -> (bool, String) {
+    let Some(words) = words else {
+        return (true, "implicit".into());
+    };
+    if output {
+        let d = crate::descriptor::host::uav_desc(words);
+        // SAFETY: each union variant is read only after checking the discriminant.
+        unsafe {
+            match d.ViewDimension {
+                D3D12_UAV_DIMENSION_TEXTURE2D => {
+                    let v = d.Anonymous.Texture2D;
+                    (
+                        v.MipSlice == 0 && v.PlaneSlice == 0,
+                        format!("uav2d.m{}.p{}", v.MipSlice, v.PlaneSlice),
+                    )
+                }
+                D3D12_UAV_DIMENSION_TEXTURE2DARRAY => {
+                    let v = d.Anonymous.Texture2DArray;
+                    (
+                        false,
+                        format!(
+                            "uav2da.m{}.p{}.a{}_{}",
+                            v.MipSlice, v.PlaneSlice, v.FirstArraySlice, v.ArraySize
+                        ),
+                    )
+                }
+                _ => (false, format!("uavdim{}", d.ViewDimension.0)),
+            }
+        }
+    } else {
+        let d = crate::descriptor::host::srv_desc(words);
+        // SAFETY: the API's typed union respects the eight-byte alignment of
+        // D3D12_BUFFER_SRV. The union does not start after the third DWORD.
+        unsafe {
+            match d.ViewDimension {
+                D3D12_SRV_DIMENSION_TEXTURE2D => {
+                    let v = d.Anonymous.Texture2D;
+                    (
+                        v.MostDetailedMip == 0 && v.PlaneSlice == 0,
+                        format!(
+                            "srv2d.m{}.n{}.p{}.lod{}",
+                            v.MostDetailedMip, v.MipLevels, v.PlaneSlice, v.ResourceMinLODClamp
+                        ),
+                    )
+                }
+                D3D12_SRV_DIMENSION_TEXTURE2DARRAY => {
+                    let v = d.Anonymous.Texture2DArray;
+                    (
+                        false,
+                        format!(
+                            "srv2da.m{}.n{}.p{}.a{}_{}.lod{}",
+                            v.MostDetailedMip,
+                            v.MipLevels,
+                            v.PlaneSlice,
+                            v.FirstArraySlice,
+                            v.ArraySize,
+                            v.ResourceMinLODClamp
+                        ),
+                    )
+                }
+                D3D12_SRV_DIMENSION_TEXTURECUBE => {
+                    let v = d.Anonymous.TextureCube;
+                    (
+                        false,
+                        format!(
+                            "srvcube.m{}.n{}.lod{}",
+                            v.MostDetailedMip, v.MipLevels, v.ResourceMinLODClamp
+                        ),
+                    )
+                }
+                _ => (false, format!("srvdim{}", d.ViewDimension.0)),
+            }
+        }
+    }
+}
+
+pub(super) fn attachments(handles: &[u64], depth: u64) -> Vec<Binding> {
+    let mut out = Vec::new();
+    for (slot, &handle) in handles.iter().enumerate() {
+        let Some(r) = crate::descriptor::rtv_record(handle) else {
+            continue;
+        };
+        let d = (!r.resource.is_null()).then(|| r.desc()).flatten();
+        let simple = d.as_ref().is_none_or(|d| {
+            // SAFETY: read only the union variant named by its discriminant.
+            d.ViewDimension == D3D12_RTV_DIMENSION_TEXTURE2D
+                && unsafe {
+                    d.Anonymous.Texture2D.MipSlice == 0 && d.Anonymous.Texture2D.PlaneSlice == 0
+                }
+        });
+        out.push(Binding {
+            label: format!("rtv{slot}"),
+            id: r.resource as usize,
+            guest_format: crate::resource::scene_format(r.resource),
+            title_memory: title_memory(r.resource),
+            subresource: d.as_ref().map_or_else(
+                || "implicit".into(),
+                |d| {
+                    // SAFETY: the discriminant selects the texture variant.
+                    unsafe {
+                        match d.ViewDimension {
+                            D3D12_RTV_DIMENSION_TEXTURE2D => {
+                                let v = d.Anonymous.Texture2D;
+                                format!("rtv2d.m{}.p{}", v.MipSlice, v.PlaneSlice)
+                            }
+                            D3D12_RTV_DIMENSION_TEXTURE2DARRAY => {
+                                let v = d.Anonymous.Texture2DArray;
+                                format!(
+                                    "rtv2da.m{}.p{}.a{}_{}",
+                                    v.MipSlice, v.PlaneSlice, v.FirstArraySlice, v.ArraySize
+                                )
+                            }
+                            _ => format!("rtvdim{}", d.ViewDimension.0),
+                        }
+                    }
+                },
+            ),
+            copy: crate::resource::host_copy(r.resource),
+            view_format: d.as_ref().map_or(0, |v| v.Format.0 as u32),
+            single_view: simple,
+            output: true,
+            depth: false,
+        });
+    }
+    if let Some(r) = crate::descriptor::dsv_record(depth) {
+        let d = (!r.resource.is_null()).then(|| r.depth_desc()).flatten();
+        let simple = d.as_ref().is_none_or(|d| {
+            // SAFETY: the union tag is checked before the read.
+            d.ViewDimension == D3D12_DSV_DIMENSION_TEXTURE2D
+                && unsafe { d.Anonymous.Texture2D.MipSlice == 0 }
+        });
+        out.push(Binding {
+            label: "dsv".into(),
+            id: r.resource as usize,
+            guest_format: crate::resource::scene_format(r.resource),
+            title_memory: title_memory(r.resource),
+            subresource: d.as_ref().map_or_else(
+                || "implicit".into(),
+                |d| {
+                    // SAFETY: the discriminant selects the texture variant.
+                    unsafe {
+                        match d.ViewDimension {
+                            D3D12_DSV_DIMENSION_TEXTURE2D => format!(
+                                "dsv2d.m{}.flags{}",
+                                d.Anonymous.Texture2D.MipSlice, d.Flags.0
+                            ),
+                            D3D12_DSV_DIMENSION_TEXTURE2DARRAY => {
+                                let v = d.Anonymous.Texture2DArray;
+                                format!(
+                                    "dsv2da.m{}.a{}_{}.flags{}",
+                                    v.MipSlice, v.FirstArraySlice, v.ArraySize, d.Flags.0
+                                )
+                            }
+                            _ => format!("dsvdim{}", d.ViewDimension.0),
+                        }
+                    }
+                },
+            ),
+            copy: crate::resource::host_copy(r.resource),
+            view_format: d.as_ref().map_or(0, |v| v.Format.0 as u32),
+            single_view: simple,
+            output: true,
+            depth: true,
+        });
+    }
+    out
+}
