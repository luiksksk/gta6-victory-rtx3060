diff --git a/crates/victory-gpu/src/list/readback.rs b/crates/victory-gpu/src/list/readback.rs
new file mode 100644
index 0000000..14b6c08
--- /dev/null
+++ b/crates/victory-gpu/src/list/readback.rs
@@ -0,0 +1,257 @@
+//! GPU texture copies into buffers in title memory.
+
+use super::{COPY_SOURCE, CopyLocation, buffer_range, ensure_state};
+use crate::host::HostList;
+use crate::resource::{PlacedFootprint, element, family, host_resource, pc_format};
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT, DXGI_SAMPLE_DESC};
+use windows::core::Interface;
+
+struct CopyLayout {
+    width: u32,
+    height: u32,
+    guest_offset: u64,
+    guest_span: u64,
+    row_bytes: u32,
+    staging_pitch: u32,
+    staging_bytes: u64,
+}
+
+impl CopyLayout {
+    fn new(
+        source: &D3D12_RESOURCE_DESC,
+        subresource: u64,
+        dst: PlacedFootprint,
+        [x, y, z]: [u32; 3],
+        area: Option<&D3D12_BOX>,
+    ) -> Option<Self> {
+        let mips = u64::from(source.MipLevels);
+        if source.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D
+            || source.SampleDesc.Count != 1
+            || source
+                .Flags
+                .contains(D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
+            || subresource >= mips * u64::from(source.DepthOrArraySize)
+            || dst.depth != 1
+            || z != 0
+            || pc_format(dst.format) != dst.format
+            || matches!(dst.format, 19..=22 | 40 | 44..=47 | 55 | 68 | 69)
+            || family(source.Format.0 as u32) != family(dst.format)
+        {
+            return None;
+        }
+        let (bytes_per_texel, 1) = element(dst.format)? else {
+            return None;
+        };
+        let texel = u32::try_from(bytes_per_texel).ok()?;
+        let mip = u32::try_from(subresource % mips).ok()?;
+        let source_width = u32::try_from(source.Width.checked_shr(mip).unwrap_or(0).max(1)).ok()?;
+        let source_height = source.Height.checked_shr(mip).unwrap_or(0).max(1);
+        let full_source = D3D12_BOX {
+            left: 0,
+            top: 0,
+            front: 0,
+            right: source_width,
+            bottom: source_height,
+            back: 1,
+        };
+        let area = area.unwrap_or(&full_source);
+        if area.right > source_width
+            || area.bottom > source_height
+            || area.front != 0
+            || area.back != 1
+            || area.left >= area.right
+            || area.top >= area.bottom
+        {
+            return None;
+        }
+        let width = area.right - area.left;
+        let height = area.bottom - area.top;
+        if x.checked_add(width)? > dst.width
+            || y.checked_add(height)? > dst.height
+            || dst.row_pitch < dst.width.checked_mul(texel)?
+        {
+            return None;
+        }
+        let guest_offset = dst
+            .offset
+            .checked_add(u64::from(y) * u64::from(dst.row_pitch))?
+            .checked_add(u64::from(x) * bytes_per_texel)?;
+        let row_bytes = width.checked_mul(texel)?;
+        let staging_pitch =
+            row_bytes.checked_next_multiple_of(D3D12_TEXTURE_DATA_PITCH_ALIGNMENT)?;
+        let row_span = |pitch| u64::from(height - 1) * u64::from(pitch) + u64::from(row_bytes);
+        Some(Self {
+            width,
+            height,
+            guest_offset,
+            guest_span: row_span(dst.row_pitch),
+            row_bytes,
+            staging_pitch,
+            staging_bytes: row_span(staging_pitch),
+        })
+    }
+}
+
+pub(super) fn record(
+    list: &HostList,
+    dst: CopyLocation,
+    position: [u32; 3],
+    src: CopyLocation,
+    area: Option<&D3D12_BOX>,
+) {
+    if record_copy(list, dst, position, src, area).is_none() {
+        tracing::debug!(
+            from = ?src.resource,
+            to = ?dst.resource,
+            subresource = src.footprint.offset,
+            ?dst.footprint,
+            ?position,
+            "texture-to-buffer copy could not be recorded"
+        );
+    }
+}
+
+fn record_copy(
+    list: &HostList,
+    dst: CopyLocation,
+    position: [u32; 3],
+    src: CopyLocation,
+    area: Option<&D3D12_BOX>,
+) -> Option<()> {
+    if src.kind != 0 {
+        return None;
+    }
+    let host = crate::host::host()?;
+    let texture = host_resource(src.resource)?;
+    // SAFETY: a live host texture.
+    let desc = unsafe { texture.GetDesc() };
+    // The subresource index occupies the first DWORD of the copy location's union.
+    let subresource = src.footprint.offset as u32;
+    let layout = CopyLayout::new(&desc, u64::from(subresource), dst.footprint, position, area)?;
+    let target = buffer_range(dst.resource, layout.guest_offset, layout.guest_span)?;
+    let buffer = allocate(&host.device, layout.staging_bytes)?;
+
+    if crate::texture::title_written(texture) {
+        crate::texture::upload(list, src.resource, texture);
+    }
+    ensure_state(list, src.resource, COPY_SOURCE);
+    let to = D3D12_TEXTURE_COPY_LOCATION {
+        // SAFETY: D3D12 copy locations borrow their resource pointers.
+        pResource: unsafe { std::mem::transmute_copy(&buffer) },
+        Type: D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+        Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+            PlacedFootprint: D3D12_PLACED_SUBRESOURCE_FOOTPRINT {
+                Offset: 0,
+                Footprint: D3D12_SUBRESOURCE_FOOTPRINT {
+                    Format: DXGI_FORMAT(dst.footprint.format as i32),
+                    Width: layout.width,
+                    Height: layout.height,
+                    Depth: 1,
+                    RowPitch: layout.staging_pitch,
+                },
+            },
+        },
+    };
+    let from = D3D12_TEXTURE_COPY_LOCATION {
+        // SAFETY: the list's state tracking keeps the host texture alive.
+        pResource: unsafe { std::mem::transmute_copy(texture) },
+        Type: D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX,
+        Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+            SubresourceIndex: subresource,
+        },
+    };
+    #[cfg(feature = "diagnostics")]
+    list.note_op(|| {
+        format!(
+            "texture readback {:?} sub {subresource} f{} {}x{} to {:?} offset {} pitch {}",
+            src.resource,
+            dst.footprint.format,
+            layout.width,
+            layout.height,
+            dst.resource,
+            layout.guest_offset,
+            dst.footprint.row_pitch,
+        )
+    });
+    // SAFETY: both resources are live; the texture and rectangle fit their locations.
+    unsafe {
+        list.list
+            .CopyTextureRegion(&to, 0, 0, 0, &from, area.map(std::ptr::from_ref))
+    };
+    list.defer_readback(Readback {
+        buffer,
+        target: target as usize,
+        guest_pitch: dst.footprint.row_pitch as usize,
+        layout,
+    });
+    Some(())
+}
+
+fn allocate(device: &ID3D12Device, bytes: u64) -> Option<ID3D12Resource> {
+    let heap = D3D12_HEAP_PROPERTIES {
+        Type: D3D12_HEAP_TYPE_READBACK,
+        ..Default::default()
+    };
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: bytes,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        ..Default::default()
+    };
+    let mut buffer = None;
+    // SAFETY: the description is a row-major buffer in a readback heap.
+    if let Err(error) = unsafe {
+        device.CreateCommittedResource(
+            &heap,
+            D3D12_HEAP_FLAG_NONE,
+            &desc,
+            D3D12_RESOURCE_STATE_COPY_DEST,
+            None,
+            &mut buffer,
+        )
+    } {
+        tracing::warn!(%error, bytes, "creating a texture readback buffer failed");
+    }
+    buffer
+}
+
+pub(crate) struct Readback {
+    buffer: ID3D12Resource,
+    target: usize,
+    guest_pitch: usize,
+    layout: CopyLayout,
+}
+
+impl Readback {
+    pub(crate) fn publish(&self) -> usize {
+        let mut mapped = std::ptr::null_mut();
+        let range = D3D12_RANGE {
+            Begin: 0,
+            End: self.layout.staging_bytes as usize,
+        };
+        // SAFETY: the queue has completed the copy and the range is within the resource.
+        if let Err(error) = unsafe { self.buffer.Map(0, Some(&range), Some(&mut mapped)) } {
+            tracing::warn!(%error, "mapping a texture readback buffer failed");
+            return 0;
+        }
+        let src = mapped.cast::<u8>();
+        let row_bytes = self.layout.row_bytes as usize;
+        for row in 0..self.layout.height as usize {
+            let from = src.wrapping_add(row * self.layout.staging_pitch as usize);
+            let to = self.target + row * self.guest_pitch;
+            crate::watch::writing(to, row_bytes);
+            crate::host::write_mapped(to as *mut u8, from, row_bytes);
+        }
+        // SAFETY: this mapping was only read by the CPU.
+        unsafe { self.buffer.Unmap(0, Some(&D3D12_RANGE::default())) };
+        self.layout.height as usize * row_bytes
+    }
+}
