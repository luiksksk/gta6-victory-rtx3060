diff --git a/crates/victory-gpu/src/queue/trace.rs b/crates/victory-gpu/src/queue/trace.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7b802efce5f60ad0f68612fca24dc772b5c4e16b
--- /dev/null
+++ b/crates/victory-gpu/src/queue/trace.rs
@@ -0,0 +1,95 @@
+//! Opt-in observation of guest queue use and waits.
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+use crate::object::This;
+
+static LISTS: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+static WAITS: AtomicU64 = AtomicU64::new(0);
+static PENDING: AtomicU64 = AtomicU64::new(0);
+static UNKNOWN: AtomicU64 = AtomicU64::new(0);
+static MEMORY_WAITS: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+
+fn interval() -> u64 {
+    static INTERVAL: OnceLock<u64> = OnceLock::new();
+    *INTERVAL.get_or_init(|| {
+        std::env::var("VICTORY_QUEUE_TRACE")
+            .ok()
+            .and_then(|s| s.parse().ok())
+            .unwrap_or(0)
+    })
+}
+
+pub(super) fn submitted(queue: This, count: u32) {
+    if interval() != 0 {
+        let index = match super::queue(queue).kind {
+            0 => 0,
+            2 => 1,
+            _ => 2,
+        };
+        LISTS[index].fetch_add(u64::from(count), Relaxed);
+    }
+}
+
+pub(super) fn wait(queue: This, fence: This, wanted: u64) {
+    if interval() == 0 {
+        return;
+    }
+    WAITS.fetch_add(1, Relaxed);
+    let Some(completed) = crate::fence::diagnostic_completed(fence) else {
+        UNKNOWN.fetch_add(1, Relaxed);
+        return;
+    };
+    if completed < wanted && PENDING.fetch_add(1, Relaxed) == 0 {
+        tracing::info!(
+            frame = super::presented(),
+            ?queue,
+            kind = super::queue(queue).kind,
+            ?fence,
+            wanted,
+            completed,
+            "first queue wait below requested fence value"
+        );
+    }
+}
+
+pub(crate) fn memory_wait(bits: u32, list: This, address: u64, comparison: u32, reference: u64) {
+    if interval() == 0 {
+        return;
+    }
+    let counter = &MEMORY_WAITS[usize::from(bits == 64)];
+    if counter.fetch_add(1, Relaxed) == 0 {
+        let reference = if bits == 32 {
+            reference & u64::from(u32::MAX)
+        } else {
+            reference
+        };
+        tracing::info!(
+            frame = super::presented(),
+            ?list,
+            bits,
+            address = format_args!("{address:#x}"),
+            comparison,
+            reference,
+            "first recorded command list memory wait"
+        );
+    }
+}
+
+pub(super) fn report(frame: u64) {
+    let every = interval();
+    if every != 0 && (frame == 1 || frame.is_multiple_of(every)) {
+        tracing::info!(
+            frame,
+            direct_lists = LISTS[0].load(Relaxed),
+            compute_lists = LISTS[1].load(Relaxed),
+            other_lists = LISTS[2].load(Relaxed),
+            fence_waits = WAITS.load(Relaxed),
+            below_requested = PENDING.load(Relaxed),
+            unknown_fences = UNKNOWN.load(Relaxed),
+            memory_waits32 = MEMORY_WAITS[0].load(Relaxed),
+            memory_waits64 = MEMORY_WAITS[1].load(Relaxed),
+            "guest queue totals"
+        );
+    }
+}
