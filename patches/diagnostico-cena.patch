+/// Optional one-shot burst; the original PNG schedule is independent.
+pub(crate) fn mesh_frames() -> u64 {
+    static LENGTH: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *LENGTH.get_or_init(|| {
+        if folder().is_none() { return 0; }
+        std::env::var("VICTORY_CAPTURE_MESH_FRAMES").ok()
