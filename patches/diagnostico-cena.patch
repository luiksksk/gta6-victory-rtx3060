diff --git a/crates/victory-shader/src/emit/bitcode/wave_reads.rs b/crates/victory-shader/src/emit/bitcode/wave_reads.rs
new file mode 100644
index 0000000000000000000000000000000000000000..19c88c3a55cf6b6fc9ac94590232d4c72b9118a1
--- /dev/null
+++ b/crates/victory-shader/src/emit/bitcode/wave_reads.rs
@@ -0,0 +1,264 @@
+use super::{Attr, Bin, Module, Op, Term};
+
+impl Module {
+    /// A lone console wave fills the whole group. Only straight-line programs with these
+    /// lane operations can use a group barrier at every read. Other waves keep their
+    /// native requirements. An index into the group is independent of hardware lane order.
+    pub(crate) fn split_wave_reads(&mut self, entry: usize) -> bool {
+        let mut reads = false;
+        for (b, block) in self.blocks.iter().enumerate() {
+            match block.term {
+                Some(Term::Ret) => {}
+                Some(Term::Br(next)) if next > b => {}
+                _ => return false,
+            }
+            for &i in &block.body {
+                if let Op::Call(f, _) = &self.insts[i as usize].op {
+                    let name = self.funcs[*f as usize].name.as_str();
+                    match name {
+                        "dx.op.waveReadLaneAt.i32" => reads = true,
+                        "dx.op.waveReadLaneFirst.i32"
+                        | "dx.op.waveGetLaneIndex"
+                        | "dx.op.groupId.i32"
+                        | "dx.op.flattenedThreadIdInGroup.i32"
+                        | "dx.op.threadIdInGroup.i32"
+                        | "dx.op.createHandleFromHeap"
+                        | "dx.op.annotateHandle"
+                        | "dx.op.getDimensions"
+                        | "dx.op.textureStore.f32"
+                        | "dx.op.tertiary.f32"
+                        | "dx.op.createHandleFromBinding"
+                        | "dx.op.cbufferLoadLegacy.i32"
+                        | "dx.op.sampleLevel.f32" => {}
+                        _ => return false,
+                    }
+                }
+            }
+        }
+        if !reads {
+            return false;
+        }
+
+        let i32t = self.int(32);
+        let void = self.void();
+        let flat_ty = self.func_ty(i32t, vec![i32t]);
+        self.ptr(flat_ty);
+        let flat_fn = self.function(
+            "dx.op.flattenedThreadIdInGroup.i32",
+            flat_ty,
+            Some(Attr::ReadNone),
+            false,
+        );
+        let barrier_ty = self.func_ty(void, vec![i32t, i32t]);
+        self.ptr(barrier_ty);
+        let barrier = self.function("dx.op.barrier", barrier_ty, Some(Attr::NoDuplicate), false);
+        let array = self.array(64, i32t);
+        let shared = self.global("wave64_exchange", array, 3);
+        let old: Vec<_> = self
+            .blocks
+            .iter_mut()
+            .map(|b| std::mem::take(&mut b.body))
+            .collect();
+        let flat_op = self.i32(96);
+        let flat = self.call(entry, flat_fn, vec![flat_op]);
+        let own = self.element(entry, shared, flat);
+        let sync_op = self.i32(80);
+        let group_shared_sync = self.i32(1 | 8);
+        let mask = self.i32(63);
+        let zero = self.i32(0);
+        for (b, body) in old.into_iter().enumerate() {
+            for i in body {
+                let Op::Call(f, args) = &self.insts[i as usize].op else {
+                    self.blocks[b].body.push(i);
+                    continue;
+                };
+                let (value, source) = match self.funcs[*f as usize].name.as_str() {
+                    "dx.op.waveGetLaneIndex" => {
+                        self.insts[i as usize].op = Op::Bin(Bin::Add, flat, zero);
+                        self.blocks[b].body.push(i);
+                        continue;
+                    }
+                    "dx.op.waveReadLaneAt.i32" => (args[1], args[2]),
+                    "dx.op.waveReadLaneFirst.i32" => (args[1], zero),
+                    _ => {
+                        self.blocks[b].body.push(i);
+                        continue;
+                    }
+                };
+                self.store(b, own, value);
+                self.call(b, barrier, vec![sync_op, group_shared_sync]);
+                let index = self.bin(b, Bin::And, source, mask);
+                let slot = self.element(b, shared, index);
+                // Keep the original SSA id: its consumers now see the shared load.
+                self.insts[i as usize].op = Op::Load(slot);
+                self.blocks[b].body.push(i);
+                // All reads finish before another exchange overwrites the same slots.
+                self.call(b, barrier, vec![sync_op, group_shared_sync]);
+            }
+        }
+        // DXIL rejects unused external declarations. The entry function is first and
+        // keeps its id. Other function references here are calls; entry metadata is
+        // constructed after lowering has finished.
+        let mut new_ids = Vec::with_capacity(self.funcs.len());
+        let mut next = 0;
+        self.funcs.retain(|f| {
+            new_ids.push(next);
+            let keep = !matches!(
+                f.name.as_str(),
+                "dx.op.waveGetLaneIndex"
+                    | "dx.op.waveReadLaneFirst.i32"
+                    | "dx.op.waveReadLaneAt.i32"
+            );
+            next += u32::from(keep);
+            keep
+        });
+        self.func_ids = self
+            .funcs
+            .iter()
+            .enumerate()
+            .map(|(i, f)| (f.name.clone(), i as u32))
+            .collect();
+        for instruction in &mut self.insts {
+            if let Op::Call(f, _) = &mut instruction.op {
+                *f = new_ids[*f as usize];
+            }
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::emit::bitcode::{Const, V};
+    use crate::emit::shader::{Shader, flags};
+
+    fn example() -> (Shader, Vec<V>) {
+        let mut s = Shader::new(false);
+        s.threads = Some([8, 8, 1]);
+        s.wave_size = Some(64);
+        s.flags = flags::WAVE_OPS;
+        let lane = s.op(
+            s.entry,
+            "waveGetLaneIndex",
+            Attr::ReadOnly,
+            s.t.i32,
+            111,
+            &[],
+        );
+        let four = s.m.i32(4);
+        let across = s.m.i32(32);
+        let high = s.m.i32(36);
+        let local = s.m.bin(s.entry, Bin::Xor, lane, four);
+        let reads = [across, high, local].map(|from| {
+            s.op(
+                s.entry,
+                "waveReadLaneAt.i32",
+                Attr::NoUnwind,
+                s.t.i32,
+                117,
+                &[lane, from],
+            )
+        });
+        s.m.terminate(s.entry, Term::Ret);
+        (s, reads.into())
+    }
+
+    fn value_at(m: &Module, v: V, lane: u32) -> u32 {
+        match v {
+            V::Const(i) => match m.consts[i as usize].1 {
+                Const::Int(n) => n as u32,
+                ref other => panic!("unexpected {other:?}"),
+            },
+            V::Inst(i) => match &m.insts[i as usize].op {
+                Op::Call(f, _)
+                    if m.funcs[*f as usize].name == "dx.op.flattenedThreadIdInGroup.i32" =>
+                {
+                    lane
+                }
+                Op::Bin(op, a, b) => {
+                    let (a, b) = (value_at(m, *a, lane), value_at(m, *b, lane));
+                    match op {
+                        Bin::And => a & b,
+                        Bin::Xor => a ^ b,
+                        Bin::Add => a + b,
+                        _ => panic!("unexpected {op:?}"),
+                    }
+                }
+                other => panic!("unexpected {other:?}"),
+            },
+            other => panic!("unexpected {other:?}"),
+        }
+    }
+
+    #[test]
+    fn split_wave_reads_exchange_the_requested_logical_lanes() {
+        let (mut s, reads) = example();
+        s.split_single_wave_reads();
+        assert_eq!(s.wave_size, None);
+        let m = &s.m;
+        let mut order = Vec::new();
+        for &i in &m.blocks[s.entry].body {
+            match &m.insts[i as usize].op {
+                Op::Store(V::Inst(slot), value) => {
+                    let Op::Gep(_, _, indices) = &m.insts[*slot as usize].op else {
+                        panic!("not shared")
+                    };
+                    for lane in 0..64 {
+                        assert_eq!(value_at(m, indices[1], lane), lane);
+                        assert_eq!(value_at(m, *value, lane), lane);
+                    }
+                    order.push("store");
+                }
+                Op::Load(_) => order.push("read"),
+                Op::Call(f, args) if m.funcs[*f as usize].name == "dx.op.barrier" => {
+                    assert_eq!(value_at(m, args[1], 0), 9);
+                    order.push("sync");
+                }
+                _ => {}
+            }
+        }
+        assert_eq!(order, ["store", "sync", "read", "sync"].repeat(3));
+        for (n, read) in reads.into_iter().enumerate() {
+            let V::Inst(i) = read else {
+                panic!("not an instruction")
+            };
+            let Op::Load(V::Inst(ptr)) = m.insts[i as usize].op else {
+                panic!("not a load")
+            };
+            let Op::Gep(_, _, indices) = &m.insts[ptr as usize].op else {
+                panic!("not shared")
+            };
+            for lane in 0..64 {
+                assert_eq!(value_at(m, indices[1], lane), [32, 36, lane ^ 4][n]);
+            }
+        }
+        #[cfg(windows)]
+        if let Some(path) = crate::emit::validator::Validator::default_path() {
+            let mut v = crate::emit::validator::Validator::load(Some(&path)).unwrap();
+            v.validate(&mut s.finish()).unwrap();
+        }
+    }
+
+    #[test]
+    fn split_wave_reads_preserve_native_requirements_for_other_groups_and_branches() {
+        let (mut small, _) = example();
+        small.threads = Some([4, 8, 1]);
+        small.split_single_wave_reads();
+        assert_eq!(small.wave_size, Some(64));
+        let (mut shared, _) = example();
+        shared.lds_dwords = 8;
+        shared.lds();
+        shared.split_single_wave_reads();
+        assert_eq!(shared.wave_size, Some(64));
+        let (mut guarded, _) = example();
+        let end = guarded.m.new_block();
+        let test = guarded.m.bool(true);
+        guarded
+            .m
+            .terminate(guarded.entry, Term::CondBr(test, end, end));
+        guarded.m.terminate(end, Term::Ret);
+        guarded.split_single_wave_reads();
+        assert_eq!(guarded.wave_size, Some(64));
+    }
+}
