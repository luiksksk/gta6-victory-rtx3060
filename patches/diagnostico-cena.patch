+static SUBMITTED_MESHES: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn mesh_submission(counts: impl Iterator<Item = u32>) {
+    if mesh_frames() != 0 {
+        let count = counts.map(u64::from).sum::<u64>();
+        if count != 0 {
+            SUBMITTED_MESHES.fetch_add(count, Ordering::Relaxed);
+        }
+    }
+}
