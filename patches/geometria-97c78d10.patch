+
+    fn value_at(m: &Module, v: V, lane: u32) -> u32 {
+        match v {
+            V::Const(i) => match m.consts[i as usize].1 {
+                Const::Int(n) => n as u32,
+                ref other => panic!("unexpected {other:?}"),
+            },
+            V::Inst(i) => match &m.insts[i as usize].op {
+                Op::Call(f, _)
+                    if m.funcs[*f as usize].name == "dx.op.flattenedThreadIdInGroup.i32" =>
+                {
+                    lane
+                }
+                Op::Bin(op, a, b) => {
+                    let (a, b) = (value_at(m, *a, lane), value_at(m, *b, lane));
+                    match op {
+                        Bin::And => a & b,
+                        Bin::Xor => a ^ b,
+                        Bin::Add => a + b,
+                        _ => panic!("unexpected {op:?}"),
+                    }
+                }
+                other => panic!("unexpected {other:?}"),
+            },
+            other => panic!("unexpected {other:?}"),
+        }
+    }
+
+    #[test]
+    fn split_wave_reads_exchange_the_requested_logical_lanes() {
+        let (mut s, reads) = example();
+        s.split_single_wave_reads();
+        assert_eq!(s.wave_size, None);
+        let m = &s.m;
+        let mut order = Vec::new();
+        for &i in &m.blocks[s.entry].body {
+            match &m.insts[i as usize].op {
+                Op::Store(V::Inst(slot), value) => {
+                    let Op::Gep(_, _, indices) = &m.insts[*slot as usize].op else {
+                        panic!("not shared")
+                    };
+                    for lane in 0..64 {
+                        assert_eq!(value_at(m, indices[1], lane), lane);
+                        assert_eq!(value_at(m, *value, lane), lane);
+                    }
+                    order.push("store");
+                }
+                Op::Load(_) => order.push("read"),
+                Op::Call(f, args) if m.funcs[*f as usize].name == "dx.op.barrier" => {
+                    assert_eq!(value_at(m, args[1], 0), 9);
+                    order.push("sync");
+                }
+                _ => {}
+            }
+        }
+        assert_eq!(order, ["store", "sync", "read", "sync"].repeat(3));
+        for (n, read) in reads.into_iter().enumerate() {
+            let V::Inst(i) = read else {
+                panic!("not an instruction")
+            };
+            let Op::Load(V::Inst(ptr)) = m.insts[i as usize].op else {
+                panic!("not a load")
+            };
+            let Op::Gep(_, _, indices) = &m.insts[ptr as usize].op else {
+                panic!("not shared")
+            };
+            for lane in 0..64 {
+                assert_eq!(value_at(m, indices[1], lane), [32, 36, lane ^ 4][n]);
+            }
+        }
+        #[cfg(windows)]
+        if let Some(path) = crate::emit::validator::Validator::default_path() {
+            let mut v = crate::emit::validator::Validator::load(Some(&path)).unwrap();
+            v.validate(&mut s.finish()).unwrap();
+        }
+    }
+
+    #[test]
+    fn split_wave_reads_preserve_native_requirements_for_other_groups_and_branches() {
+        let (mut small, _) = example();
+        small.threads = Some([4, 8, 1]);
+        small.split_single_wave_reads();
+        assert_eq!(small.wave_size, Some(64));
+        let (mut shared, _) = example();
+        shared.lds_dwords = 8;
+        shared.lds();
+        shared.split_single_wave_reads();
+        assert_eq!(shared.wave_size, Some(64));
+        let (mut guarded, _) = example();
+        let end = guarded.m.new_block();
+        let test = guarded.m.bool(true);
+        guarded
+            .m
+            .terminate(guarded.entry, Term::CondBr(test, end, end));
+        guarded.m.terminate(end, Term::Ret);
+        guarded.split_single_wave_reads();
+        assert_eq!(guarded.wave_size, Some(64));
+    }
+}
