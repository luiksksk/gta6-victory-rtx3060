+            Dimension: D3D12_RESOURCE_DIMENSION_TEXTURE2D,
+            Width: 1280,
+            Height: 720,
+            DepthOrArraySize: 1,
+            MipLevels: 1,
+            Format: DXGI_FORMAT_R8G8B8A8_TYPELESS,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            Flags: D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET
+                | D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS,
+            ..Default::default()
+        };
+        let reader = srv(29, &resource).unwrap();
+        let writer = uav(29, &resource).unwrap();
+        assert_eq!(reader.Format, DXGI_FORMAT_R8G8B8A8_UNORM_SRGB);
+        assert_eq!(writer.Format, DXGI_FORMAT_R8G8B8A8_UNORM);
+        assert_eq!(reader.ViewDimension, D3D12_SRV_DIMENSION_TEXTURE2D);
+        assert_eq!(writer.ViewDimension, D3D12_UAV_DIMENSION_TEXTURE2D);
+        assert!(srv(91, &resource).is_none());
+        resource.DepthOrArraySize = 4;
+        resource.MipLevels = 3;
+        let reader = srv(29, &resource).unwrap();
+        let writer = uav(29, &resource).unwrap();
+        // SAFETY: this array resource selects the Texture2DArray union member.
+        unsafe {
+            assert_eq!(reader.Anonymous.Texture2DArray.MipLevels, 3);
+            assert_eq!(reader.Anonymous.Texture2DArray.ArraySize, 4);
+            assert_eq!(writer.Anonymous.Texture2DArray.MipSlice, 0);
+            assert_eq!(writer.Anonymous.Texture2DArray.ArraySize, 4);
+        }
+        resource.SampleDesc.Count = 4;
+        assert_eq!(
+            srv(29, &resource).unwrap().ViewDimension,
+            D3D12_SRV_DIMENSION_TEXTURE2DMSARRAY
+        );
+        assert!(uav(29, &resource).is_none());
+    }
+}
