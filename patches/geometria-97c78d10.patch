diff --git a/crates/victory-gpu/src/pipeline/prewarm.rs b/crates/victory-gpu/src/pipeline/prewarm.rs
new file mode 100644
index 0000000000000000000000000000000000000000..602c26e12ded234fe310c63f04bebfcb19f26cca
--- /dev/null
+++ b/crates/victory-gpu/src/pipeline/prewarm.rs
@@ -0,0 +1,161 @@
+//! Prepare title-created pipelines whose shader stages were bound in a previous run.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, OnceLock, mpsc};
+
+use crate::object::{self, This};
+
+struct Prewarm {
+    stages: HashSet<Vec<u64>>,
+    jobs: mpsc::Sender<Job>,
+}
+
+/// A strong interface reference until the worker finishes with this pipeline.
+struct Job(This);
+
+// SAFETY: The object, shader containers and owned graphics description are immutable
+// once handed out. host_pipeline initializes the D3D12 objects through a OnceLock.
+unsafe impl Send for Job {}
+
+impl Drop for Job {
+    fn drop(&mut self) {
+        super::release(self.0);
+    }
+}
+
+static SCHEDULED: AtomicUsize = AtomicUsize::new(0);
+static FINISHED: AtomicUsize = AtomicUsize::new(0);
+static READY_BEFORE_BIND: AtomicUsize = AtomicUsize::new(0);
+
+pub(super) fn schedule(this: This) {
+    static PREWARM: OnceLock<Option<Prewarm>> = OnceLock::new();
+    let Some(prewarm) = PREWARM.get_or_init(start) else {
+        return;
+    };
+    let pipeline = super::pipeline(this);
+    let mut stages: Vec<u64> = pipeline
+        .shaders
+        .iter()
+        .filter_map(|s| hash(&s.hash))
+        .collect();
+    stages.sort_unstable();
+    if stages.is_empty() || !prewarm.stages.contains(&stages) {
+        return;
+    }
+    object::add_ref(this);
+    SCHEDULED.fetch_add(1, Ordering::Relaxed);
+    if prewarm.jobs.send(Job(this)).is_err() {
+        SCHEDULED.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+fn hash(text: &str) -> Option<u64> {
+    (text.len() == 16)
+        .then(|| u64::from_str_radix(text, 16).ok())
+        .flatten()
+}
+
+/// A pipeline address can be reused by the title. Keep each frame's bindings separate.
+fn observed(log: &str) -> HashSet<Vec<u64>> {
+    let mut objects: HashMap<(&str, &str), Vec<u64>> = HashMap::new();
+    for line in log.lines() {
+        let Some((_, fields)) = line.split_once(": first bind ") else {
+            continue;
+        };
+        let field = |prefix: &str| {
+            fields
+                .split_ascii_whitespace()
+                .find_map(|s| s.strip_prefix(prefix))
+        };
+        if let (Some(pipeline), Some(frame), Some(shader)) = (
+            field("pipeline="),
+            field("frame="),
+            field("hash=").and_then(hash),
+        ) {
+            objects.entry((pipeline, frame)).or_default().push(shader);
+        }
+    }
+    objects
+        .into_values()
+        .map(|mut stages| {
+            stages.sort_unstable();
+            stages
+        })
+        .collect()
+}
+
+fn start() -> Option<Prewarm> {
+    let path = std::env::var_os("VICTORY_PREWARM_LOG")?;
+    let log = match std::fs::read_to_string(&path) {
+        Ok(log) => log,
+        Err(error) => {
+            tracing::warn!(?path, %error, "could not read pipeline prewarm log");
+            return None;
+        }
+    };
+    let stages = observed(&log);
+    if stages.is_empty() {
+        tracing::warn!(?path, "pipeline prewarm log contains no first bindings");
+        return None;
+    }
+    let (jobs, receiver) = mpsc::channel::<Job>();
+    let receiver = Arc::new(Mutex::new(receiver));
+    let mut workers = 0;
+    for i in 0..2 {
+        let receiver = Arc::clone(&receiver);
+        let start = std::thread::Builder::new()
+            .name(format!("victory-pso-{i}"))
+            .spawn(move || {
+                loop {
+                    let job = receiver.lock().unwrap_or_else(|e| e.into_inner()).recv();
+                    let Ok(job) = job else { break };
+                    let ready = super::host_pipeline(job.0).is_some();
+                    if ready && !super::pipeline(job.0).bound.load(Ordering::Acquire) {
+                        READY_BEFORE_BIND.fetch_add(1, Ordering::Relaxed);
+                    }
+                    let finished = FINISHED.fetch_add(1, Ordering::Relaxed) + 1;
+                    if finished == 1 || finished.is_multiple_of(128) {
+                        tracing::info!(
+                            finished,
+                            scheduled = SCHEDULED.load(Ordering::Relaxed),
+                            ready_before_bind = READY_BEFORE_BIND.load(Ordering::Relaxed),
+                            "pipeline prewarm"
+                        );
+                    }
+                }
+            });
+        match start {
+            Ok(_) => workers += 1,
+            Err(error) => tracing::warn!(%error, "could not start a pipeline prewarm worker"),
+        }
+    }
+    if workers == 0 {
+        return None;
+    }
+    tracing::info!(
+        ?path,
+        sets = stages.len(),
+        workers,
+        "selected pipeline prewarm enabled"
+    );
+    Some(Prewarm { stages, jobs })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::observed;
+
+    #[test]
+    fn selects_complete_stage_sets_and_handles_reused_addresses() {
+        let log = "time INFO gpu: first bind pipeline=0x1 frame=7271 stage=vertex size=64 hash=0000000000000002\n\
+                   time INFO gpu: first bind pipeline=0x2 frame=7271 stage=compute size=64 hash=0000000000000007\n\
+                   time INFO gpu: first bind pipeline=0x1 frame=7271 stage=pixel size=64 hash=0000000000000001\n\
+                   time INFO gpu: first bind pipeline=0x1 frame=7272 stage=compute size=64 hash=0000000000000003\n\
+                   time INFO gpu: shader translated stage=pixel hash=0000000000000004\n\
+                   time INFO gpu: first bind pipeline=0x3 frame=7272 stage=compute hash=invalid";
+        let sets = observed(log);
+        assert_eq!(sets.len(), 3);
+        assert!(sets.contains(&vec![1, 2]) && sets.contains(&vec![3]) && sets.contains(&vec![7]));
+    }
+}
