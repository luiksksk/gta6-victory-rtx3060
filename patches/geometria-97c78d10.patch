new file mode 100644
index 0000000000000000000000000000000000000000..45f434ed9d523580afe1f9176f50fcc2468496ae
--- /dev/null
+++ b/crates/victory-gpu/src/readback.rs
@@ -0,0 +1,459 @@
+//! Copies a host texture region into a title buffer after GPU completion.
+
+use crate::host::{self, HostList};
+use crate::object::{self, This};
+use crate::resource::{self, PlacedFootprint};
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT, DXGI_SAMPLE_DESC};
+
+/// Layout of the copied rectangle in compact host staging and in the title's footprint.
+#[derive(Debug)]
+struct Rows {
+    first: usize,
+    dst_pitch: usize,
+    dst_slice: usize,
+    host_pitch: usize,
+    host_slice: usize,
+    count: usize,
+    depth: usize,
+    bytes: usize,
+}
+
+/// One element's width, height and size in bytes.
+fn block(format: u32) -> Option<(u32, u32, usize)> {
+    match format {
+        66 => Some((8, 1, 1)),      // R1_UNORM
+        68 | 69 => Some((2, 1, 4)), // two RGB pixels per packed pair
+        // Formats whose console representation is different from the host's.
+        118..=120 => None,
+        _ => resource::element(format)
+            .map(|(bytes, side)| (side as u32, side as u32, bytes as usize)),
+    }
+}
+
+impl Rows {
+    fn new(fp: PlacedFootprint, at: [u32; 3], size: [u32; 3], buffer_size: u64) -> Option<Self> {
+        let [x, y, z] = at;
+        let [w, h, d] = size;
+        let (bw, bh, element) = block(fp.format)?;
+        let end_x = x.checked_add(w)?;
+        let end_y = y.checked_add(h)?;
+        if w == 0
+            || h == 0
+            || d == 0
+            || end_x > fp.width
+            || end_y > fp.height
+            || z.checked_add(d)? > fp.depth
+            || !x.is_multiple_of(bw)
+            || !y.is_multiple_of(bh)
+            || (!w.is_multiple_of(bw) && end_x != fp.width)
+            || (!h.is_multiple_of(bh) && end_y != fp.height)
+        {
+            return None;
+        }
+        let dst_pitch = fp.row_pitch as usize;
+        let row = |width: u32| (width.div_ceil(bw) as usize).checked_mul(element);
+        if dst_pitch < row(fp.width)? {
+            return None;
+        }
+        let dst_slice = dst_pitch.checked_mul(fp.height.div_ceil(bh) as usize)?;
+        let bytes = row(w)?;
+        let count = h.div_ceil(bh) as usize;
+        let host_pitch =
+            bytes.checked_next_multiple_of(D3D12_TEXTURE_DATA_PITCH_ALIGNMENT as usize)?;
+        u32::try_from(host_pitch).ok()?;
+        let host_slice = host_pitch.checked_mul(count)?;
+        host_slice.checked_mul(d as usize)?;
+        let first = usize::try_from(fp.offset)
+            .ok()?
+            .checked_add((z as usize).checked_mul(dst_slice)?)?
+            .checked_add(((y / bh) as usize).checked_mul(dst_pitch)?)?
+            .checked_add(row(x)?)?;
+        let end = first
+            .checked_add(((d - 1) as usize).checked_mul(dst_slice)?)?
+            .checked_add((count - 1).checked_mul(dst_pitch)?)?
+            .checked_add(bytes)?;
+        if end as u64 > buffer_size {
+            return None;
+        }
+        Some(Self {
+            first,
+            dst_pitch,
+            dst_slice,
+            host_pitch,
+            host_slice,
+            count,
+            depth: d as usize,
+            bytes,
+        })
+    }
+
+    fn staging_bytes(&self) -> usize {
+        self.host_slice * self.depth
+    }
+
+    fn read_end(&self) -> usize {
+        self.host_slice * (self.depth - 1) + self.host_pitch * (self.count - 1) + self.bytes
+    }
+
+    fn for_each(&self, mut row: impl FnMut(usize, usize, usize)) {
+        for z in 0..self.depth {
+            for y in 0..self.count {
+                row(
+                    z * self.host_slice + y * self.host_pitch,
+                    self.first + z * self.dst_slice + y * self.dst_pitch,
+                    self.bytes,
+                );
+            }
+        }
+    }
+}
+
+/// Holds both resources across recording, submission and list replay.
+pub(crate) struct Readback {
+    staging: ID3D12Resource,
+    destination: usize,
+    rows: Rows,
+    #[cfg(feature = "diagnostics")]
+    format: u32,
+}
+
+impl Drop for Readback {
+    fn drop(&mut self) {
+        resource::resource_release(self.destination as This);
+    }
+}
+
+impl Readback {
+    pub(crate) fn publish(&self) {
+        let (dst, _) = resource::buffer_bytes(self.destination as This)
+            .expect("readback keeps the destination buffer alive");
+        let mut mapped = std::ptr::null_mut();
+        let range = D3D12_RANGE {
+            Begin: 0,
+            End: self.rows.read_end(),
+        };
+        // SAFETY: the submission fence completed and the range is inside staging.
+        if let Err(e) = unsafe { self.staging.Map(0, Some(&range), Some(&mut mapped)) } {
+            host::fail(format_args!(
+                "mapping completed texture readback failed ({e})"
+            ));
+        }
+        let src = mapped.cast::<u8>();
+        self.rows.for_each(|from, to, bytes| {
+            let dest = dst.wrapping_add(to);
+            crate::watch::writing(dest as usize, bytes);
+            if host::write_mapped(dest, src.wrapping_add(from), bytes) != bytes {
+                host::fail(format_args!(
+                    "texture readback could not write {bytes} bytes at title buffer offset {to:#x}"
+                ));
+            }
+        });
+        #[cfg(feature = "diagnostics")]
+        {
+            static TRACE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+            static COUNT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+            if *TRACE.get_or_init(|| std::env::var_os("VICTORY_TRACE_READBACK").is_some())
+                && COUNT.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 32
+            {
+                // SAFETY: the first row is mapped; log at most the first 20 words.
+                let sample = unsafe { std::slice::from_raw_parts(src, self.rows.bytes.min(80)) };
+                let mut title = [0u8; 80];
+                let guest_matches = host::read_into(
+                    dst.wrapping_add(self.rows.first),
+                    &mut title[..sample.len()],
+                ) && title[..sample.len()] == *sample;
+                let words: Vec<_> = sample
+                    .chunks_exact(4)
+                    .map(|w| u32::from_le_bytes(w.try_into().unwrap()))
+                    .collect();
+                tracing::info!(
+                    format = self.format,
+                    guest_matches,
+                    ?words,
+                    rows = self.rows.count,
+                    depth = self.rows.depth,
+                    row_bytes = self.rows.bytes,
+                    offset = self.rows.first,
+                    "texture readback published"
+                );
+            }
+        }
+        // SAFETY: the CPU did not write the readback heap.
+        unsafe {
+            self.staging
+                .Unmap(0, Some(&D3D12_RANGE { Begin: 0, End: 0 }))
+        };
+    }
+}
+
+/// A committed buffer which stays in COPY_DEST for its whole lifetime.
+pub(crate) fn buffer(device: &ID3D12Device, size: u64) -> windows::core::Result<ID3D12Resource> {
+    let desc = D3D12_RESOURCE_DESC {
+        Dimension: D3D12_RESOURCE_DIMENSION_BUFFER,
+        Width: size,
+        Height: 1,
+        DepthOrArraySize: 1,
+        MipLevels: 1,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Layout: D3D12_TEXTURE_LAYOUT_ROW_MAJOR,
+        ..Default::default()
+    };
+    let heap = D3D12_HEAP_PROPERTIES {
+        Type: D3D12_HEAP_TYPE_READBACK,
+        ..Default::default()
+    };
+    let mut resource = None;
+    // SAFETY: a complete buffer description with an output owned by this call.
+    unsafe {
+        device.CreateCommittedResource(
+            &heap,
+            D3D12_HEAP_FLAG_NONE,
+            &desc,
+            D3D12_RESOURCE_STATE_COPY_DEST,
+            None,
+            &mut resource,
+        )?
+    };
+    resource.ok_or_else(windows::core::Error::empty)
+}
+
+pub(crate) fn record(
+    list: &HostList,
+    source: This,
+    sub: u32,
+    source_box: Option<[u32; 6]>,
+    destination: This,
+    fp: PlacedFootprint,
+    at: [u32; 3],
+) -> Result<(), &'static str> {
+    let (_, buffer_size) =
+        resource::buffer_bytes(destination).ok_or("destination is not a buffer")?;
+    let texture = resource::host_resource(source).ok_or("source has no host texture")?;
+    let device = &host::host().ok_or("no host device")?.device;
+    // SAFETY: this is the live host texture for the title resource.
+    let desc = unsafe { texture.GetDesc() };
+    if desc.SampleDesc.Count != 1 {
+        return Err("multisample texture needs resolving first");
+    }
+    if desc.Flags.contains(D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)
+        && (source_box.is_some() || at != [0; 3])
+    {
+        return Err("depth copy must cover a complete subresource");
+    }
+    let mut info = D3D12_FEATURE_DATA_FORMAT_INFO {
+        Format: desc.Format,
+        ..Default::default()
+    };
+    // SAFETY: queries for this exact format and structure size.
+    unsafe {
+        device.CheckFeatureSupport(
+            D3D12_FEATURE_FORMAT_INFO,
+            (&raw mut info).cast(),
+            size_of_val(&info) as u32,
+        )
+    }
+    .map_err(|_| "unknown source plane count")?;
+    let is_3d = desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE3D;
+    let slices = if is_3d {
+        1
+    } else {
+        u32::from(desc.DepthOrArraySize)
+    };
+    let mips = u32::from(desc.MipLevels);
+    if mips == 0 || sub >= slices * mips * u32::from(info.PlaneCount) {
+        return Err("source subresource index outside texture");
+    }
+    let mut native = D3D12_PLACED_SUBRESOURCE_FOOTPRINT::default();
+    let mut total = 0;
+    // SAFETY: one checked subresource, one output footprint.
+    unsafe {
+        device.GetCopyableFootprints(
+            &desc,
+            sub,
+            1,
+            0,
+            Some(&mut native),
+            None,
+            None,
+            Some(&mut total),
+        )
+    };
+    if total == 0
+        || total == u64::MAX
+        || resource::family(native.Footprint.Format.0 as u32) != resource::family(fp.format)
+    {
+        return Err("incompatible host and destination copy formats");
+    }
+    let (bw, bh, _) = block(fp.format).ok_or("unsupported destination block layout")?;
+    // GetCopyableFootprints may pad BC footprints to whole blocks. Bound boxes by
+    // the logical mip in that case, and use the device's per-plane dimensions otherwise.
+    let mip = sub % mips;
+    let source_size = [
+        if bw > 1 {
+            (desc.Width >> mip).max(1) as u32
+        } else {
+            native.Footprint.Width
+        },
+        if bh > 1 {
+            (desc.Height >> mip).max(1)
+        } else {
+            native.Footprint.Height
+        },
+        native.Footprint.Depth,
+    ];
+    let [left, top, front, right, bottom, back] =
+        source_box.unwrap_or([0, 0, 0, source_size[0], source_size[1], source_size[2]]);
+    if left >= right || top >= bottom || front >= back {
+        return Ok(());
+    }
+    if right > source_size[0]
+        || bottom > source_size[1]
+        || back > source_size[2]
+        || !left.is_multiple_of(bw)
+        || !top.is_multiple_of(bh)
+        || (!right.is_multiple_of(bw) && right != source_size[0])
+        || (!bottom.is_multiple_of(bh) && bottom != source_size[1])
+    {
+        return Err("source box outside its mip or off a block boundary");
+    }
+    let size = [right - left, bottom - top, back - front];
+    let rows = Rows::new(fp, at, size, buffer_size)
+        .ok_or("copy outside destination footprint or buffer")?;
+    let staging = buffer(device, rows.staging_bytes() as u64)
+        .map_err(|_| "cannot allocate readback staging")?;
+    let footprint = D3D12_PLACED_SUBRESOURCE_FOOTPRINT {
+        Offset: 0,
+        Footprint: D3D12_SUBRESOURCE_FOOTPRINT {
+            Format: DXGI_FORMAT(fp.format as i32),
+            Width: size[0].next_multiple_of(bw),
+            Height: size[1].next_multiple_of(bh),
+            Depth: size[2],
+            RowPitch: rows.host_pitch as u32,
+        },
+    };
+    let region = D3D12_BOX {
+        left,
+        top,
+        front,
+        right,
+        bottom,
+        back,
+    };
+    if crate::texture::title_written(texture) {
+        crate::texture::upload(list, source, texture);
+    }
+    crate::list::ensure_state(list, source, D3D12_RESOURCE_STATE_COPY_SOURCE.0 as u32);
+    #[cfg(feature = "diagnostics")]
+    list.note_op(|| format!("texture readback {source:?} sub {sub}, box {source_box:?} to {destination:?} {at:?} {fp:?}"));
+    // SAFETY: open list; resources are retained until reset. The two borrowed
+    // COM pointers in the locations are ManuallyDrop and do not own a reference.
+    unsafe {
+        let to = D3D12_TEXTURE_COPY_LOCATION {
+            pResource: std::mem::transmute_copy(&staging),
+            Type: D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT,
+            Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+                PlacedFootprint: footprint,
+            },
+        };
+        let from = D3D12_TEXTURE_COPY_LOCATION {
+            pResource: std::mem::transmute_copy(texture),
+            Type: D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX,
+            Anonymous: D3D12_TEXTURE_COPY_LOCATION_0 {
+                SubresourceIndex: sub,
+            },
+        };
+        list.list
+            .CopyTextureRegion(&to, 0, 0, 0, &from, source_box.map(|_| &raw const region));
+    }
+    object::add_ref(destination);
+    list.defer_readback(Readback {
+        staging,
+        destination: destination as usize,
+        rows,
+        #[cfg(feature = "diagnostics")]
+        format: fp.format,
+    });
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn footprint() -> PlacedFootprint {
+        PlacedFootprint {
+            offset: 0,
+            format: 2,
+            width: 5,
+            height: 1,
+            depth: 1,
+            row_pitch: 256,
+        }
+    }
+
+    #[test]
+    fn five_rgba32f_pixels_publish_exactly_eighty_bytes() {
+        let fp = footprint();
+        let layout = Rows::new(fp, [0; 3], [5, 1, 1], 80).unwrap();
+        assert_eq!(layout.staging_bytes(), 256);
+        assert_eq!(layout.read_end(), 80);
+        let mut stage = [0x93; 256];
+        let words: Vec<_> = (0..20)
+            .map(|n| ((n as f32 - 8.25) * 0.375).to_le_bytes())
+            .collect();
+        let reference: Vec<_> = words.into_iter().flatten().collect();
+        stage[..80].copy_from_slice(&reference);
+        let mut title = [0x71; 256];
+        layout.for_each(|s, d, bytes| title[d..d + bytes].copy_from_slice(&stage[s..s + bytes]));
+        assert_eq!(title[..80], reference);
+        assert_eq!(title[80..], [0x71; 176]);
+        assert!(Rows::new(fp, [0; 3], [5, 1, 1], 79).is_none());
+    }
+
+    #[test]
+    fn partial_rows_slices_and_offset_preserve_unwritten_bytes() {
+        let fp = PlacedFootprint {
+            offset: 512,
+            format: 28,
+            width: 8,
+            height: 4,
+            depth: 3,
+            row_pitch: 512,
+        };
+        let rows = Rows::new(fp, [2, 1, 1], [3, 2, 2], 7000).unwrap();
+        let mut stage = vec![0x93u8; rows.staging_bytes()];
+        let starts = [3080, 3592, 5128, 5640];
+        let mut expected = vec![0xd8u8; 7000];
+        for (i, dst) in starts.into_iter().enumerate() {
+            stage[i * 256..i * 256 + 12].fill(i as u8);
+            expected[dst..dst + 12].fill(i as u8);
+        }
+        let mut title = vec![0xd8u8; 7000];
+        rows.for_each(|s, d, n| title[d..d + n].copy_from_slice(&stage[s..s + n]));
+        assert_eq!(title, expected);
+        assert!(Rows::new(fp, [2, 1, 1], [3, 2, 2], 5651).is_none());
+        assert!(Rows::new(fp, [u32::MAX, 0, 0], [3, 1, 1], u64::MAX).is_none());
+    }
+
+    #[test]
+    fn compressed_mip_edges_copy_whole_blocks() {
+        let fp = PlacedFootprint {
+            offset: 0,
+            format: 71,
+            width: 7,
+            height: 5,
+            depth: 1,
+            row_pitch: 256,
+        };
+        let rows = Rows::new(fp, [4, 4, 0], [3, 1, 1], 272).unwrap();
+        let mut written = Vec::new();
+        rows.for_each(|s, d, n| written.push((s, d, n)));
+        assert_eq!(written, [(0, 264, 8)]);
+        assert!(Rows::new(fp, [2, 4, 0], [3, 1, 1], 272).is_none());
+        assert!(Rows::new(fp, [0; 3], [3, 1, 1], 272).is_none());
+    }
+}
