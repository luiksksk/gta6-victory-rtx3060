diff --git a/crates/victory-gpu/src/scene_hdr.rs b/crates/victory-gpu/src/scene_hdr.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ec3d889f9915ebfe66845b17645fd716dbac945b
--- /dev/null
+++ b/crates/victory-gpu/src/scene_hdr.rs
@@ -0,0 +1,283 @@
+//! Optional RGB9E5 render targets on devices that cannot write that format.
+//! Title memory keeps the console's packed layout. Only GPU-writable textures
+//! use the expanded backing. Mixed-format transfers require conversion.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+
+pub(crate) const PACKED: u32 = DXGI_FORMAT_R9G9B9E5_SHAREDEXP.0 as u32;
+pub(crate) const EXPANDED: u32 = DXGI_FORMAT_R16G16B16A16_FLOAT.0 as u32;
+
+pub(crate) fn writable(format: u32, flags: u32) -> bool {
+    let writes_color =
+        D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET | D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    format == PACKED
+        && flags & writes_color.0 as u32 != 0
+        && flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL.0 as u32 == 0
+}
+
+fn format_support(
+    device: &ID3D12Device,
+    format: DXGI_FORMAT,
+) -> Option<D3D12_FEATURE_DATA_FORMAT_SUPPORT> {
+    let mut data = D3D12_FEATURE_DATA_FORMAT_SUPPORT {
+        Format: format,
+        ..Default::default()
+    };
+    // SAFETY: a live device and an output structure of the query's type and size.
+    unsafe {
+        device
+            .CheckFeatureSupport(
+                D3D12_FEATURE_FORMAT_SUPPORT,
+                (&raw mut data).cast(),
+                size_of_val(&data) as u32,
+            )
+            .ok()?
+    };
+    Some(data)
+}
+
+fn writable_and_sampleable(caps: &D3D12_FEATURE_DATA_FORMAT_SUPPORT) -> bool {
+    let uses = D3D12_FORMAT_SUPPORT1_TEXTURE2D
+        | D3D12_FORMAT_SUPPORT1_RENDER_TARGET
+        | D3D12_FORMAT_SUPPORT1_SHADER_SAMPLE
+        | D3D12_FORMAT_SUPPORT1_TYPED_UNORDERED_ACCESS_VIEW;
+    let uav = D3D12_FORMAT_SUPPORT2_UAV_TYPED_STORE | D3D12_FORMAT_SUPPORT2_UAV_TYPED_LOAD;
+    caps.Support1.contains(uses) && caps.Support2.contains(uav)
+}
+
+pub(crate) fn enabled() -> bool {
+    static ACTIVE: OnceLock<bool> = OnceLock::new();
+    *ACTIVE.get_or_init(|| {
+        if std::env::var_os("VICTORY_EXPAND_SCENE_HDR").as_deref()
+            != Some(std::ffi::OsStr::new("1"))
+        {
+            return false;
+        }
+        let Some(host) = crate::host::host() else {
+            return false;
+        };
+        let packed = format_support(&host.device, DXGI_FORMAT_R9G9B9E5_SHAREDEXP);
+        let expanded = format_support(&host.device, DXGI_FORMAT_R16G16B16A16_FLOAT);
+        let active = packed.is_some_and(|p| !writable_and_sampleable(&p))
+            && expanded.is_some_and(|p| writable_and_sampleable(&p));
+        tracing::info!(active, ?packed, ?expanded, "scene HDR format support");
+        active
+    })
+}
+
+pub(crate) fn rtv_format(format: u32) -> u32 {
+    if format == PACKED && enabled() {
+        EXPANDED
+    } else {
+        format
+    }
+}
+
+/// RGB9E5 samples have a constant alpha of one. A custom swizzle can
+/// select that source component for any output lane.
+fn rgb_mapping(mut mapping: u32) -> u32 {
+    for shift in [0, 3, 6, 9] {
+        if (mapping >> shift) & 7 == D3D12_SHADER_COMPONENT_MAPPING_FROM_MEMORY_COMPONENT_3.0 as u32
+        {
+            mapping = (mapping & !(7 << shift))
+                | ((D3D12_SHADER_COMPONENT_MAPPING_FORCE_VALUE_1.0 as u32) << shift);
+        }
+    }
+    mapping
+}
+
+/// The implicit texture SRV describes all subresources and the resource's
+/// dimension. Spell it out so the shader still gets RGB9E5's alpha of one.
+fn implicit_srv(d: &D3D12_RESOURCE_DESC) -> Option<D3D12_SHADER_RESOURCE_VIEW_DESC> {
+    let mips = u32::from(d.MipLevels);
+    let slices = u32::from(d.DepthOrArraySize);
+    let (dim, data) = match (d.Dimension, slices > 1, d.SampleDesc.Count > 1) {
+        (D3D12_RESOURCE_DIMENSION_TEXTURE1D, false, false) => (
+            D3D12_SRV_DIMENSION_TEXTURE1D,
+            D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture1D: D3D12_TEX1D_SRV {
+                    MipLevels: mips,
+                    ..Default::default()
+                },
+            },
+        ),
+        (D3D12_RESOURCE_DIMENSION_TEXTURE1D, true, false) => (
+            D3D12_SRV_DIMENSION_TEXTURE1DARRAY,
+            D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture1DArray: D3D12_TEX1D_ARRAY_SRV {
+                    MipLevels: mips,
+                    ArraySize: slices,
+                    ..Default::default()
+                },
+            },
+        ),
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, false, false) => (
+            D3D12_SRV_DIMENSION_TEXTURE2D,
+            D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture2D: D3D12_TEX2D_SRV {
+                    MipLevels: mips,
+                    ..Default::default()
+                },
+            },
+        ),
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, true, false) => (
+            D3D12_SRV_DIMENSION_TEXTURE2DARRAY,
+            D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture2DArray: D3D12_TEX2D_ARRAY_SRV {
+                    MipLevels: mips,
+                    ArraySize: slices,
+                    ..Default::default()
+                },
+            },
+        ),
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, false, true) => {
+            (D3D12_SRV_DIMENSION_TEXTURE2DMS, Default::default())
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, true, true) => (
+            D3D12_SRV_DIMENSION_TEXTURE2DMSARRAY,
+            D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture2DMSArray: D3D12_TEX2DMS_ARRAY_SRV {
+                    ArraySize: slices,
+                    ..Default::default()
+                },
+            },
+        ),
+        (D3D12_RESOURCE_DIMENSION_TEXTURE3D, _, false) => (
+            D3D12_SRV_DIMENSION_TEXTURE3D,
+            D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture3D: D3D12_TEX3D_SRV {
+                    MipLevels: mips,
+                    ..Default::default()
+                },
+            },
+        ),
+        _ => return None,
+    };
+    Some(D3D12_SHADER_RESOURCE_VIEW_DESC {
+        Format: DXGI_FORMAT_R16G16B16A16_FLOAT,
+        ViewDimension: dim,
+        Shader4ComponentMapping: D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING,
+        Anonymous: data,
+    })
+}
+
+pub(crate) fn shader_view(
+    texture: &ID3D12Resource,
+    desc: Option<D3D12_SHADER_RESOURCE_VIEW_DESC>,
+) -> Option<D3D12_SHADER_RESOURCE_VIEW_DESC> {
+    let mut view = match desc {
+        Some(desc) => desc,
+        // SAFETY: a live, expanded texture.
+        None => implicit_srv(&unsafe { texture.GetDesc() })?,
+    };
+    if desc.is_some() && !matches!(view.Format.0 as u32, 0 | PACKED) {
+        rejected(Reject::View);
+        return None;
+    }
+    view.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    view.Shader4ComponentMapping = rgb_mapping(view.Shader4ComponentMapping);
+    Some(view)
+}
+
+#[derive(Debug, Clone, Copy)]
+pub(crate) enum Reject {
+    Upload,
+    CopyResource,
+    CopyRegion,
+    Resolve,
+    View,
+    Clear,
+}
+
+static COUNT: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+
+pub(crate) fn rejected(kind: Reject) {
+    let count = COUNT[kind as usize].fetch_add(1, Ordering::Relaxed) + 1;
+    if count.is_power_of_two() {
+        tracing::warn!(
+            ?kind,
+            count,
+            "scene HDR operation needs packed RGB9E5 conversion"
+        );
+    }
+}
+
+pub(crate) fn log_rejections() {
+    if !enabled() {
+        return;
+    }
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    let [upload, resource, region, resolve, view, clear] =
+        COUNT.each_ref().map(|n| n.load(Ordering::Relaxed));
+    let total = upload + resource + region + resolve + view + clear;
+    if LAST.swap(total, Ordering::Relaxed) != total {
+        tracing::info!(
+            upload,
+            resource,
+            region,
+            resolve,
+            view,
+            clear,
+            "scene HDR rejected operations to date"
+        );
+    }
+}
+
+pub(crate) fn allow_copy(
+    dst: crate::object::This,
+    src: crate::object::This,
+    subresources: bool,
+    kind: Reject,
+) -> bool {
+    let allowed = compatible_copy(
+        crate::resource::expanded_scene_hdr(dst),
+        crate::resource::expanded_scene_hdr(src),
+        subresources,
+    );
+    if !allowed {
+        rejected(kind);
+    }
+    allowed
+}
+
+pub(crate) fn compatible_copy(dst: bool, src: bool, both_subresources: bool) -> bool {
+    (!dst && !src) || (dst && src && both_subresources)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scene_hdr_only_expands_writable_color() {
+        for f in [1, 4, 5, 0x300005] {
+            assert!(writable(PACKED, f));
+        }
+        for f in [0, 2, 6, 8, 0x300000] {
+            assert!(!writable(PACKED, f));
+        }
+        assert!(!writable(EXPANDED, 5));
+    }
+
+    #[test]
+    fn scene_hdr_does_not_copy_packed_bytes_into_halves() {
+        assert!(compatible_copy(false, false, false));
+        assert!(compatible_copy(true, true, true));
+        assert!(!compatible_copy(true, false, true));
+        assert!(!compatible_copy(false, true, true));
+        assert!(!compatible_copy(true, true, false));
+    }
+
+    #[test]
+    fn scene_hdr_swizzle_preserves_rgb_and_forces_original_alpha() {
+        assert_eq!(
+            rgb_mapping(D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING),
+            (D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING & !(7 << 9)) | (5 << 9)
+        );
+        let a_b_zero_r = (1 << 12) | (4 << 6) | (2 << 3) | 3;
+        assert_eq!(rgb_mapping(a_b_zero_r), (a_b_zero_r & !7) | 5);
+    }
+}
