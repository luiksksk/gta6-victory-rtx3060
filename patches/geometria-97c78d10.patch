+//! A typed title texture can have a typeless host resource so that it can
+//! be sampled as sRGB and written through a linear UAV. D3D12 cannot infer
+//! default views for typeless resources; inherit the title's shape and type.
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+
+fn srgb(guest: u32, resource: &D3D12_RESOURCE_DESC) -> Option<(DXGI_FORMAT, DXGI_FORMAT)> {
+    let &(_, linear) = crate::resource::SRGB.iter().find(|&&(g, _)| g == guest)?;
+    (resource.Format.0 as u32 == crate::resource::family(guest))
+        .then_some((DXGI_FORMAT(guest as i32), DXGI_FORMAT(linear as i32)))
+}
+
+pub(super) fn srv(guest: u32, d: &D3D12_RESOURCE_DESC) -> Option<D3D12_SHADER_RESOURCE_VIEW_DESC> {
+    let (format, _) = srgb(guest, d)?;
+    let mut view = D3D12_SHADER_RESOURCE_VIEW_DESC {
+        Format: format,
+        Shader4ComponentMapping: D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING,
+        ..Default::default()
+    };
+    let slices = u32::from(d.DepthOrArraySize);
+    let mips = if d.MipLevels == 0 {
+        u32::MAX
+    } else {
+        u32::from(d.MipLevels)
+    };
+    view.ViewDimension = match (d.Dimension, slices > 1, d.SampleDesc.Count > 1) {
+        (D3D12_RESOURCE_DIMENSION_TEXTURE1D, false, false) => {
+            view.Anonymous.Texture1D = D3D12_TEX1D_SRV {
+                MipLevels: mips,
+                ..Default::default()
+            };
+            D3D12_SRV_DIMENSION_TEXTURE1D
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE1D, true, false) => {
+            view.Anonymous.Texture1DArray = D3D12_TEX1D_ARRAY_SRV {
+                MipLevels: mips,
+                ArraySize: slices,
+                ..Default::default()
+            };
+            D3D12_SRV_DIMENSION_TEXTURE1DARRAY
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, false, false) => {
+            view.Anonymous.Texture2D = D3D12_TEX2D_SRV {
+                MipLevels: mips,
+                ..Default::default()
+            };
+            D3D12_SRV_DIMENSION_TEXTURE2D
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, true, false) => {
+            view.Anonymous.Texture2DArray = D3D12_TEX2D_ARRAY_SRV {
+                MipLevels: mips,
+                ArraySize: slices,
+                ..Default::default()
+            };
+            D3D12_SRV_DIMENSION_TEXTURE2DARRAY
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, false, true) => D3D12_SRV_DIMENSION_TEXTURE2DMS,
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, true, true) => {
+            view.Anonymous.Texture2DMSArray = D3D12_TEX2DMS_ARRAY_SRV {
+                ArraySize: slices,
+                ..Default::default()
+            };
+            D3D12_SRV_DIMENSION_TEXTURE2DMSARRAY
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE3D, _, false) => {
+            view.Anonymous.Texture3D = D3D12_TEX3D_SRV {
+                MipLevels: mips,
+                ..Default::default()
+            };
+            D3D12_SRV_DIMENSION_TEXTURE3D
+        }
+        _ => return None,
+    };
+    Some(view)
+}
+
+pub(super) fn uav(guest: u32, d: &D3D12_RESOURCE_DESC) -> Option<D3D12_UNORDERED_ACCESS_VIEW_DESC> {
+    let (_, format) = srgb(guest, d)?;
+    if d.SampleDesc.Count != 1 || !d.Flags.contains(D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) {
+        return None;
+    }
+    let slices = u32::from(d.DepthOrArraySize);
+    let mut view = D3D12_UNORDERED_ACCESS_VIEW_DESC {
+        Format: format,
+        ..Default::default()
+    };
+    view.ViewDimension = match (d.Dimension, slices > 1) {
+        (D3D12_RESOURCE_DIMENSION_TEXTURE1D, false) => D3D12_UAV_DIMENSION_TEXTURE1D,
+        (D3D12_RESOURCE_DIMENSION_TEXTURE1D, true) => {
+            view.Anonymous.Texture1DArray = D3D12_TEX1D_ARRAY_UAV {
+                ArraySize: slices,
+                ..Default::default()
+            };
+            D3D12_UAV_DIMENSION_TEXTURE1DARRAY
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, false) => D3D12_UAV_DIMENSION_TEXTURE2D,
+        (D3D12_RESOURCE_DIMENSION_TEXTURE2D, true) => {
+            view.Anonymous.Texture2DArray = D3D12_TEX2D_ARRAY_UAV {
+                ArraySize: slices,
+                ..Default::default()
+            };
+            D3D12_UAV_DIMENSION_TEXTURE2DARRAY
+        }
+        (D3D12_RESOURCE_DIMENSION_TEXTURE3D, _) => {
+            view.Anonymous.Texture3D = D3D12_TEX3D_UAV {
+                WSize: slices,
+                ..Default::default()
+            };
+            D3D12_UAV_DIMENSION_TEXTURE3D
+        }
+        _ => return None,
+    };
+    Some(view)
+}
