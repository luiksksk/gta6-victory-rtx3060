+#[cfg(test)]
+mod tests {
+    use crate::{HwStage, ir, resource};
+
+    fn code() -> Vec<u32> {
+        vec![
+            0x87ea6a7e, // s_and_b64 vcc, exec, vcc
+            0xbf870001, // s_cbranch_vccnz to the address calculation
+            0xbf810000, // s_endpgm
+            0xd5580000, 0x02210083, // v_med3_i32 v0, 3, 0, 8
+            0xbe801f00, // s_getpc_b64 s[0:1]; next PC = 24
+            0x8000ff00, 64,         // s_add_u32 s0, s0, 64
+            0x82018001, // s_addc_u32 s1, s1, 0
+            0xd7460000, 0x04010300, // v_lshl_add_u32 v0, v0, 1, v0
+            0x3002009f, // v_ashrrev_i32 v1, 31, v0
+            0xd6ff0001, 0x00020082, // v_lshlrev_b64 v[1:2], 2, v[0:1]
+            0xd70f6a01, 0x00000101, // v_add_co_u32 v1, vcc, v1, s0
+            0x50040401, // v_add_co_ci_u32 v2, vcc, s1, v2, vcc
+            0x7e040501, 0x7e060502, // v_readfirstlane_b32 s2, v1; s3, v2
+            0xf4000181, 0xfa000000, // s_load_dword s6, s[2:3], null
+            0xbf810000, // s_endpgm
+        ]
+    }
+
+    fn table(words: &[u32]) -> Option<u32> {
+        let code: Vec<_> = words.iter().flat_map(|x| x.to_le_bytes()).collect();
+        let p = ir::build(&code, true, 8).unwrap();
+        let resources = resource::track(&p, &[], HwStage::Cs).ok()?;
+        let [(_, a)] = resources.scalar[..] else {
+            return None;
+        };
+        (a.param == resource::CODE && a.dynamic.is_none()).then_some(a.offset)
+    }
+
+    #[test]
+    fn first_lane_code_pointer_needs_a_constant_index_live_lane_and_both_carries() {
+        let words = code();
+        assert_eq!(table(&words), Some(24 + 64 + 9 * 4));
+        let mut changed = words.clone();
+        changed[4] = (changed[4] & !511) | 259; // first median operand is now v3
+        assert_eq!(table(&changed), None);
+        let mut changed = words.clone();
+        changed[1] = 0xbf860001; // branch if VCC is zero
+        assert_eq!(table(&changed), None);
+        let mut changed = words.clone();
+        changed.insert(16, 0xBEEA0480); // s_mov_b64 vcc, 0 replaces the lane carry
+        assert_eq!(table(&changed), None);
+        let mut changed = words;
+        changed.insert(8, 0xBF068080); // s_cmp_eq_u32 0, 0 replaces the scalar carry
+        assert_eq!(table(&changed), None);
+    }
+}
