+pub(crate) fn present_override(frame: u64) -> Option<std::sync::Arc<crate::resource::HostTexture>> {
+    let (.., n) = present_spec()?;
+    let mut p = PRESENTED.lock().unwrap_or_else(|e| e.into_inner());
+    if p.0 != frame {
+        return None;
+    }
+    let (_, list) = std::mem::take(&mut *p);
+    list.into_iter().nth(n).map(|(_, t)| t)
+}
