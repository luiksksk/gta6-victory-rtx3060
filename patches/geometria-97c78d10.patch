+/// Distinguishes allocation failures from formats the title actually binds.
+#[cfg(all(windows, feature = "diagnostics"))]
+pub(crate) fn note_texture_binding(
+    this: This,
+    usage: &'static str,
+    view_format: Option<u32>,
+    root: Option<(u8, u32)>,
+    pipeline: usize,
+) {
+    use std::collections::BTreeSet;
+    use std::sync::{Mutex, OnceLock};
+    static FROM: OnceLock<Option<u64>> = OnceLock::new();
+    let Some(from) = FROM.get_or_init(|| {
+        std::env::var("VICTORY_TRACE_TEXTURE_FORMATS").ok()?.parse().ok()
+    }) else { return };
+    let frame = crate::queue::presented() + 1;
+    if this.is_null() || frame < *from {
+        return;
+    }
+    let r = resource(this);
+    if r.desc.dimension == BUFFER || !matches!(r.desc.format, 29 | 67 | 86 | 91 | 93 | 115) {
+        return;
+    }
+    // Explicit sRGB descriptors already specify their types.
+    if matches!(r.desc.format, 29 | 91 | 93) && (usage == "RTV" || view_format.is_some()) {
+        return;
+    }
+    type Binding = (usize, usize, &'static str, Option<u32>);
+    static SEEN: Mutex<(u64, BTreeSet<Binding>)> = Mutex::new((0, BTreeSet::new()));
+    let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+    if seen.0 != frame {
+        seen.0 = frame;
+        seen.1.clear();
+    }
+    if seen.1.len() >= 64 || !seen.1.insert((this as usize, pipeline, usage, view_format)) {
+        return;
+    }
+    // SAFETY: the title resource retains its host texture.
+    let native = host_resource(this).map(|t| unsafe { t.GetDesc() }.Format.0);
+    tracing::info!(frame, usage, guest = r.desc.format, flags = r.desc.flags,
+        ?native, ?view_format, ?root, width = r.desc.width, height = r.desc.height,
+        resource = format_args!("{:#x}", this as usize), pipeline = format_args!("{pipeline:#x}"),
+        "bound title texture format");
+}
