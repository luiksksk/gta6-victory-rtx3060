+        let high = s.m.i32(36);
+        let local = s.m.bin(s.entry, Bin::Xor, lane, four);
+        let reads = [across, high, local].map(|from| {
+            s.op(
+                s.entry,
+                "waveReadLaneAt.i32",
+                Attr::NoUnwind,
