+use super::{Attr, Bin, Module, Op, Term};
+
+impl Module {
+    /// A lone console wave fills the whole group. Only straight-line programs with these
+    /// lane operations can use a group barrier at every read. Other waves keep their
+    /// native requirements. An index into the group is independent of hardware lane order.
+    pub(crate) fn split_wave_reads(&mut self, entry: usize) -> bool {
+        let mut reads = false;
+        for (b, block) in self.blocks.iter().enumerate() {
+            match block.term {
+                Some(Term::Ret) => {}
+                Some(Term::Br(next)) if next > b => {}
+                _ => return false,
+            }
+            for &i in &block.body {
+                if let Op::Call(f, _) = &self.insts[i as usize].op {
+                    let name = self.funcs[*f as usize].name.as_str();
+                    match name {
+                        "dx.op.waveReadLaneAt.i32" => reads = true,
+                        "dx.op.waveReadLaneFirst.i32"
+                        | "dx.op.waveGetLaneIndex"
+                        | "dx.op.groupId.i32"
+                        | "dx.op.flattenedThreadIdInGroup.i32"
+                        | "dx.op.threadIdInGroup.i32"
+                        | "dx.op.createHandleFromHeap"
+                        | "dx.op.annotateHandle"
+                        | "dx.op.getDimensions"
+                        | "dx.op.textureStore.f32"
+                        | "dx.op.tertiary.f32"
+                        | "dx.op.createHandleFromBinding"
+                        | "dx.op.cbufferLoadLegacy.i32"
+                        | "dx.op.sampleLevel.f32" => {}
+                        _ => return false,
+                    }
+                }
+            }
+        }
+        if !reads {
+            return false;
+        }
+
+        let i32t = self.int(32);
+        let void = self.void();
+        let flat_ty = self.func_ty(i32t, vec![i32t]);
+        self.ptr(flat_ty);
+        let flat_fn = self.function(
+            "dx.op.flattenedThreadIdInGroup.i32",
+            flat_ty,
+            Some(Attr::ReadNone),
+            false,
+        );
+        let barrier_ty = self.func_ty(void, vec![i32t, i32t]);
+        self.ptr(barrier_ty);
+        let barrier = self.function("dx.op.barrier", barrier_ty, Some(Attr::NoDuplicate), false);
+        let array = self.array(64, i32t);
+        let shared = self.global("wave64_exchange", array, 3);
+        let old: Vec<_> = self
+            .blocks
+            .iter_mut()
+            .map(|b| std::mem::take(&mut b.body))
+            .collect();
+        let flat_op = self.i32(96);
+        let flat = self.call(entry, flat_fn, vec![flat_op]);
+        let own = self.element(entry, shared, flat);
+        let sync_op = self.i32(80);
+        let group_shared_sync = self.i32(1 | 8);
+        let mask = self.i32(63);
+        let zero = self.i32(0);
+        for (b, body) in old.into_iter().enumerate() {
+            for i in body {
+                let Op::Call(f, args) = &self.insts[i as usize].op else {
+                    self.blocks[b].body.push(i);
+                    continue;
+                };
+                let (value, source) = match self.funcs[*f as usize].name.as_str() {
+                    "dx.op.waveGetLaneIndex" => {
+                        self.insts[i as usize].op = Op::Bin(Bin::Add, flat, zero);
+                        self.blocks[b].body.push(i);
+                        continue;
+                    }
+                    "dx.op.waveReadLaneAt.i32" => (args[1], args[2]),
+                    "dx.op.waveReadLaneFirst.i32" => (args[1], zero),
+                    _ => {
+                        self.blocks[b].body.push(i);
+                        continue;
+                    }
+                };
+                self.store(b, own, value);
+                self.call(b, barrier, vec![sync_op, group_shared_sync]);
+                let index = self.bin(b, Bin::And, source, mask);
+                let slot = self.element(b, shared, index);
+                // Keep the original SSA id: its consumers now see the shared load.
+                self.insts[i as usize].op = Op::Load(slot);
+                self.blocks[b].body.push(i);
+                // All reads finish before another exchange overwrites the same slots.
+                self.call(b, barrier, vec![sync_op, group_shared_sync]);
+            }
+        }
+        // DXIL rejects unused external declarations. The entry function is first and
+        // keeps its id. Other function references here are calls; entry metadata is
+        // constructed after lowering has finished.
+        let mut new_ids = Vec::with_capacity(self.funcs.len());
+        let mut next = 0;
+        self.funcs.retain(|f| {
+            new_ids.push(next);
+            let keep = !matches!(
+                f.name.as_str(),
+                "dx.op.waveGetLaneIndex"
+                    | "dx.op.waveReadLaneFirst.i32"
+                    | "dx.op.waveReadLaneAt.i32"
+            );
+            next += u32::from(keep);
+            keep
+        });
+        self.func_ids = self
+            .funcs
+            .iter()
+            .enumerate()
+            .map(|(i, f)| (f.name.clone(), i as u32))
+            .collect();
+        for instruction in &mut self.insts {
+            if let Op::Call(f, _) = &mut instruction.op {
+                *f = new_ids[*f as usize];
+            }
+        }
+        true
+    }
+}
