+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::emit::bitcode::{Const, V};
+    use crate::emit::shader::{Shader, flags};
+
+    fn example() -> (Shader, Vec<V>) {
+        let mut s = Shader::new(false);
+        s.threads = Some([8, 8, 1]);
