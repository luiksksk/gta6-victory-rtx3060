+static SCENE_FRAME: AtomicU64 = AtomicU64::new(0);
+pub(crate) fn arm_scene_targets(frame: u64, meshes: u64) {
+    if meshes >= 16 { SCENE_STARTED.store(true, Ordering::Relaxed); }
+    if meshes >= 16 {
+        PRESENTED_SCENE_FRAMES.fetch_add(1, Ordering::Relaxed);
+    }
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if meshes >= 16 && *ON.get_or_init(|| std::env::var_os("VICTORY_SCENE_TARGETS").is_some()) {
+        let _ = SCENE_FRAME.compare_exchange(0, frame + 1, Ordering::Relaxed, Ordering::Relaxed);
+    }
+}
