--- /dev/null
+++ b/crates/victory-shader/src/resource/constant_code.rs
@@ -0,0 +1,267 @@
+//! Statically indexed code tables whose 64-bit address moves from VGPRs
+//! through a pair of v_readfirstlane instructions before a scalar load.
+
+use super::{Term, Tracer, inline};
+use crate::gfx10::{Fields, Operand, Valu};
+use crate::ir::{EXEC, Exit, Inst, Reg, VCC, Value};
+
+fn simple_valu(inst: &Inst) -> Option<&Valu> {
+    let Fields::Valu(v) = &inst.fields else {
+        return None;
+    };
+    (v.abs == 0
+        && v.neg == 0
+        && v.opsel == 0
+        && !v.clamp
+        && v.omod == 0
+        && v.sdwa.is_none()
+        && v.dpp.is_none())
+    .then_some(v)
+}
+
+impl Tracer<'_> {
+    pub(super) fn constant_lane_code_address(&self, lo: Term, hi: Term) -> Option<u32> {
+        let (Term::Value(lo), Term::Value(hi)) = (lo, hi) else {
+            return None;
+        };
+        let (block, _) = self.defs[lo.0 as usize]?;
+        let count = if self.p.wave64 { 2 } else { 1 };
+        let first = self.def(lo)?;
+        if first.name() != "v_readfirstlane_b32" {
+            return None;
+        }
+        let active = |inst: &Inst| {
+            (0..count).all(|k| {
+                first.read(Reg::S(EXEC + k)).is_some()
+                    && inst.read(Reg::S(EXEC + k)) == first.read(Reg::S(EXEC + k))
+            })
+        };
+        // If EXEC were empty, the hardware can read an old value from lane
+        // zero. Require an edge which proves at least one of these lanes is on.
+        let [previous] = self.p.blocks[block].preds[..] else {
+            return None;
+        };
+        let pred = &self.p.blocks[previous];
+        if !matches!(pred.exit, Exit::Branch { taken, not_taken } if taken == block && not_taken != block)
+        {
+            return None;
+        }
+        let [.., mask, branch] = &pred.insts[..] else {
+            return None;
+        };
+        let Fields::Sop { src, .. } = &mask.fields else {
+            return None;
+        };
+        if branch.name() != "s_cbranch_vccnz"
+            || mask.name()
+                != if self.p.wave64 {
+                    "s_and_b64"
+                } else {
+                    "s_and_b32"
+                }
+            || !active(mask)
+            || !src.contains(&Operand::Scalar {
+                code: EXEC,
+                dwords: count,
+            })
+            || !(0..count).all(|k| {
+                mask.write(Reg::S(VCC + k)).is_some()
+                    && mask.write(Reg::S(VCC + k)) == branch.read(Reg::S(VCC + k))
+            })
+        {
+            return None;
+        }
+        let read_add = |v: Value, opcode| {
+            let (b, _) = self.defs[v.0 as usize]?;
+            let read = self.def(v)?;
+            if b != block || read.name() != "v_readfirstlane_b32" || !active(read) {
+                return None;
+            }
+            let [Operand::Vector { reg, .. }] = &simple_valu(read)?.src[..] else {
+                return None;
+            };
+            let result = read.read(Reg::V(*reg))?;
+            let (site, _) = self.defs[result.0 as usize]?;
+            let add = self.def(result)?;
+            let op = simple_valu(add)?;
+            if site != block
+                || add.name() != opcode
+                || !active(add)
+                || op.dst
+                    != Some(Operand::Vector {
+                        reg: *reg,
+                        dwords: 1,
+                    })
+            {
+                return None;
+            }
+            let (scalar, vector) = match *op.src.get(..2)? {
+                [s @ Operand::Scalar { .. }, v @ Operand::Vector { .. }]
+                | [v @ Operand::Vector { .. }, s @ Operand::Scalar { .. }] => (s, v),
+                _ => return None,
+            };
+            Some((add, self.term(add, &scalar)?, vector))
+        };
+        let (low, base_lo, delta_lo) = read_add(lo, "v_add_co_u32")?;
+        let (high, base_hi, delta_hi) = read_add(hi, "v_add_co_ci_u32")?;
+        let Operand::Scalar { code, dwords } = simple_valu(low)?.carry? else {
+            return None;
+        };
+        if dwords != count
+            || simple_valu(high)?.src.get(2) != Some(&Operand::Scalar { code, dwords })
+            || !(0..count).all(|k| {
+                low.write(Reg::S(code + k)).is_some()
+                    && low.write(Reg::S(code + k)) == high.read(Reg::S(code + k))
+            })
+        {
+            return None;
+        }
+        // Check both halves of s_getpc + immediate and the actual SCC chain.
+        let (Term::Value(base_lo), Term::Value(base_hi)) = (base_lo, base_hi) else {
+            return None;
+        };
+        let (base, terms) = self.sop2(base_lo, &["s_add_u32"])?;
+        let (pc, imm) = match terms {
+            [Term::Value(v), Term::Const(c)] | [Term::Const(c), Term::Value(v)] => {
+                (self.getpc(v)?, c)
+            }
+            _ => return None,
+        };
+        let (carry, terms) = self.sop2(base_hi, &["s_addc_u32"])?;
+        let pc_hi = Term::Value(pc.writes.get(1)?.1);
+        if terms != [pc_hi, Term::Const(0)] && terms != [Term::Const(0), pc_hi]
+            || base.write(Reg::Scc).is_none()
+            || base.write(Reg::Scc) != carry.read(Reg::Scc)
+        {
+            return None;
+        }
+        let lane = ConstantLane {
+            tracer: self,
+            block,
+            exec: first,
+        };
+        let mut budget = 128;
+        let lo = lane.operand(low, delta_lo, 0, &mut budget)?;
+        let hi = lane.operand(high, delta_hi, 0, &mut budget)?;
+        // A forward byte offset inside this shader. Out-of-file displacements
+        // are rejected when the code table is read.
+        (hi == 0).then_some(())?;
+        u32::try_from(pc.machine.offset)
+            .ok()?
+            .checked_add(4)?
+            .checked_add(imm)?
+            .checked_add(lo)
+    }
+}
+
+struct ConstantLane<'a, 'p> {
+    tracer: &'a Tracer<'p>,
+    block: usize,
+    exec: &'a Inst,
+}
+
+impl ConstantLane<'_, '_> {
+    /// Evaluate only integer operations over instruction constants under the
+    /// same active-lane mask. A live input, phi or another mask has no value.
+    fn operand(&self, user: &Inst, op: Operand, word: u8, budget: &mut u8) -> Option<u32> {
+        let (reg, size) = match op {
+            Operand::Const(c) if word == 0 => return inline(c),
+            Operand::Literal(x) if word == 0 => return Some(x),
+            Operand::Vector { reg, dwords } => (reg, dwords),
+            _ => return None,
+        };
+        if word >= size {
+            return None;
+        }
+        *budget = budget.checked_sub(1)?;
+        let reg = reg.checked_add(word)?;
+        let v = user.read(Reg::V(reg))?;
+        let (b, _) = self.tracer.defs[v.0 as usize]?;
+        let inst = self.tracer.def(v)?;
+        let n = if self.tracer.p.wave64 { 2 } else { 1 };
+        if b != self.block
+            || !(0..n).all(|k| inst.read(Reg::S(EXEC + k)) == self.exec.read(Reg::S(EXEC + k)))
+        {
+            return None;
+        }
+        let f = simple_valu(inst)?;
+        let Operand::Vector { reg: dst, dwords } = f.dst? else {
+            return None;
+        };
+        let index = reg.checked_sub(dst)?;
+        if index >= dwords {
+            return None;
+        }
+        let mut src = |i, w| self.operand(inst, *f.src.get(i)?, w, budget);
+        let a = src(0, 0)?;
+        let b = src(1, 0)?;
+        match (inst.name(), index) {
+            ("v_add_nc_u32", 0) => Some(a.wrapping_add(b)),
+            ("v_lshl_add_u32", 0) => Some(a.wrapping_shl(b).wrapping_add(src(2, 0)?)),
+            ("v_ashrrev_i32", 0) => Some((b as i32).wrapping_shr(a) as u32),
+            ("v_med3_i32", 0) => {
+                let mut v = [a as i32, b as i32, src(2, 0)? as i32];
+                v.sort_unstable();
+                Some(v[1] as u32)
+            }
+            ("v_lshlrev_b64", 0 | 1) => {
+                let pair = u64::from(b) | (u64::from(src(1, 1)?) << 32);
+                Some((pair.wrapping_shl(a) >> (32 * u32::from(index))) as u32)
+            }
+            _ => None,
+        }
+    }
+}
