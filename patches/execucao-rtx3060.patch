+fn table_resources<'a>(stages: impl Iterator<Item = &'a [UsedResource]>) -> Vec<UsedResource> {
+    let mut resources: Vec<_> = stages
+        .flatten()
+        .filter(|u| u.root == RootType::Table)
+        .copied()
+        .collect();
+    resources.sort_by_key(|u| (u.slot, u.table_offset_dwords));
+    resources
+}
