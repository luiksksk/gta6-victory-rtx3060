+    use super::*;
+    use victory_shader::ResourceType;
+
+    #[test]
+    fn stages_sharing_a_table_keep_all_its_entries() {
+        let entry = |kind, offset| UsedResource {
+            kind,
+            root: RootType::Table,
+            table_offset_dwords: offset,
+            lower_bound: 0,
+            stride: 0,
+            dwords: 8,
+            user_data: 8,
+            slot: 0,
+        };
+        let vertex = [entry(ResourceType::Srv, 0), entry(ResourceType::Cbv, 16)];
+        let pixel = [entry(ResourceType::Srv, 8), UsedResource {
+            root: RootType::ImmediateSampler,
+            ..entry(ResourceType::Sampler, 0)
+        }];
+        let used = table_resources([vertex.as_slice(), pixel.as_slice()].into_iter());
+        assert_eq!(used, [vertex[0], pixel[0], vertex[1]]);
+    }
+}
