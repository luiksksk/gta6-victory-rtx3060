+    /// A console export may be active in lanes beyond the declared DXIL output.
+    fn mesh_output_guard(&mut self, primitive: bool, guard: Option<V>) -> Option<V> {
+        let mesh = self.s.mesh.expect("mesh export");
+        let limit = if primitive { mesh.max_primitives } else { mesh.max_vertices };
+        if self.s.threads.expect("mesh threads")[0] <= limit {
+            return guard;
+        }
+        let flat = self.mesh_thread();
+        let limit = self.s.m.i32(limit);
+        let within = self.s.m.cmp(self.cur, pred::IULT, flat, limit);
+        Some(guard.map_or(within, |g| self.s.m.bin(self.cur, Bin::And, g, within)))
+    }
