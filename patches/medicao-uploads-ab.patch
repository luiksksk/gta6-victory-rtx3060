index 8b7d13df1e80af4c3f608313a11501f3b715d343..1ef8de5f12496c755313d497b53be06df3e33047 100644
--- a/crates/victory-gpu/src/copystat.rs
+++ b/crates/victory-gpu/src/copystat.rs
@@ -42,6 +42,11 @@ const COUNTERS: usize = 22;
 static COUNT: [AtomicU64; COUNTERS] = [const { AtomicU64::new(0) }; COUNTERS];
 
 pub(crate) fn add(c: C, n: u64) {
+    match c {
+        C::Checked => event(Event::Checked, n),
+        C::Unchanged => event(Event::Unchanged, n),
+        _ => {}
+    }
     COUNT[c as usize].fetch_add(n, Relaxed);
 }
 
@@ -145,3 +150,24 @@ pub(crate) fn log(frames: f64) {
         );
     }
 }
+
+/// Monotonic counters: samples at successful presents are independent of
+/// the variable averaging interval of the FPS display.
+#[derive(Clone, Copy)]
+pub(crate) enum Event {
+    Checked, Unchanged, ReadbackChecked, DifferentBytes, UnknownBytes,
+    Written, FenceUs, FreshTables, PlansUs, RecordsUs, UploadCommands, Dropped,
+}
+static TOTAL: [AtomicU64; 12] = [const { AtomicU64::new(0) }; 12];
+
+pub(crate) fn event(kind: Event, value: u64) {
+    TOTAL[kind as usize].fetch_add(value, Relaxed);
+}
+
+pub(crate) fn scene_present(frame: u64) {
+    static SAMPLES: AtomicU64 = AtomicU64::new(0);
+    if SAMPLES.fetch_add(1, Relaxed) < 100 {
+        let counts = TOTAL.each_ref().map(|c| c.load(Relaxed));
+        tracing::info!(frame, ?counts, "upload comparison present");
+    }
+}
