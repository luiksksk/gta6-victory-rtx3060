+    fn typeless_view_on_typeless_resource_remaps_to_concrete_format() {
+        let adapt = |format, view: Option<&mut DXGI_FORMAT>, unordered| {
+            adapt_view_format(
+                &D3D12_RESOURCE_DESC {
+                    Format: DXGI_FORMAT(format),
+                    ..Default::default()
+                },
+                view,
+                unordered,
+            )
