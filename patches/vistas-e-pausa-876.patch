+        let mut fmt = DXGI_FORMAT(27);
+        assert!(adapt(27, Some(&mut fmt), false));
+        assert_eq!(fmt.0, 28);
+
+        // B8G8R8A8_TYPELESS (90) with B8G8R8A8_TYPELESS view (90) -> B8G8R8A8_UNORM (87)
+        let mut fmt = DXGI_FORMAT(90);
