diff --git a/crates/victory-gpu/src/pause_scene.rs b/crates/victory-gpu/src/pause_scene.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ef5b57e0eb813bb8d558d522da838f109960b09a
--- /dev/null
+++ b/crates/victory-gpu/src/pause_scene.rs
@@ -0,0 +1,108 @@
+//! Diagnostic for the Series X prologue. Keep the last submitted mesh
+//! frame's material colour available to the title's own upscale and UI.
+use std::sync::{Mutex, OnceLock};
+use windows::Win32::Graphics::Direct3D12::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+
+static LAST: Mutex<Option<ID3D12Resource>> = Mutex::new(None);
+
+pub(crate) fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("VICTORY_PAUSE_SCENE").as_deref() == Ok("1")
+            && std::env::var_os("VICTORY_PRESENT_TARGET").is_none()
+    })
+}
+
+fn refresh_scene(meshes: u64, layers: u16, mips: u16, samples: u32) -> bool {
+    meshes > 0 && (layers, mips, samples) == (1, 1, 1)
+}
+
+pub(crate) fn record(
+    host: &crate::host::Host,
+    list: &crate::host::HostList,
+    frame: u64,
+    meshes: u64,
+    presented: &ID3D12Resource,
+) -> Option<ID3D12Resource> {
+    let source = crate::capture::present_override(frame)?;
+    // SAFETY: the captured reference owns the selected texture.
+    let mut desc = unsafe { source.texture.GetDesc() };
+    if source.texture == *presented
+        || desc.Format != DXGI_FORMAT_R8G8B8A8_TYPELESS
+        || !refresh_scene(
+            meshes,
+            desc.DepthOrArraySize,
+            desc.MipLevels,
+            desc.SampleDesc.Count,
+        )
+    {
+        return None;
+    }
+    // A private, immutable typed copy also survives clears and resource reuse
+    // while the title continues presenting UI without submitting meshes.
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+    let heap = D3D12_HEAP_PROPERTIES {
+        Type: D3D12_HEAP_TYPE_DEFAULT,
+        ..Default::default()
+    };
+    let mut image: Option<ID3D12Resource> = None;
+    // SAFETY: compatible size and format family; the list prelude orders the
+    // source against its last submitted writer. Publish only after execution.
+    unsafe {
+        host.device
+            .CreateCommittedResource(
+                &heap,
+                D3D12_HEAP_FLAG_NONE,
+                &desc,
+                D3D12_RESOURCE_STATE_COPY_DEST,
+                None,
+                &mut image,
+            )
+            .ok()?;
+        let image = image?;
+        let read = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        if let Some(before) = list.transition_copy(source.clone(), read.0 as u32) {
+            list.list.ResourceBarrier(&[crate::host::transition(
+                &source.texture,
+                D3D12_RESOURCE_STATES(before as i32),
+                read,
+            )]);
+        }
+        list.list.CopyResource(&image, &source.texture);
+        list.list.ResourceBarrier(&[crate::host::transition(
+            &image,
+            D3D12_RESOURCE_STATE_COPY_DEST,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+        )]);
+        Some(image)
+    }
+}
+
+pub(crate) fn publish(image: ID3D12Resource) {
+    static FIRST: std::sync::Once = std::sync::Once::new();
+    FIRST.call_once(|| tracing::info!("saved mesh colour for the native upscaler"));
+    *LAST.lock().unwrap_or_else(|e| e.into_inner()) = Some(image);
+}
+
+pub(crate) fn for_shader(hash: &str) -> Option<ID3D12Resource> {
+    if hash != "4f4ec7b16673362f" || !enabled() {
+        return None;
+    }
+    LAST.lock().unwrap_or_else(|e| e.into_inner()).clone()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pause_keeps_the_last_scene_until_another_mesh_frame() {
+        assert!(refresh_scene(18, 1, 1, 1));
+        assert!(!refresh_scene(0, 1, 1, 1));
+        assert!(!refresh_scene(18, 2, 1, 1));
+        assert!(!refresh_scene(18, 1, 2, 1));
+        assert!(!refresh_scene(18, 1, 1, 4));
+    }
+}
