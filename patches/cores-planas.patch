diff --git a/crates/victory-gpu/src/pipeline/geometria.hlsl b/crates/victory-gpu/src/pipeline/geometria.hlsl
new file mode 100644
index 0000000000000000000000000000000000000000..2f7d1bddf3716c34d2b29340384124045a05fa97
--- /dev/null
+++ b/crates/victory-gpu/src/pipeline/geometria.hlsl
@@ -0,0 +1,26 @@
+// Diagnostic display of rasterized title geometry. The depth gradients come
+// from the original vertex or mesh shader and the current title viewport.
+struct Colors {
+    float4 first : SV_Target0;
+    float4 second : SV_Target1;
+    float4 third : SV_Target2;
+    float4 fourth : SV_Target3;
+    float4 fifth : SV_Target4;
+    float4 sixth : SV_Target5;
+    float4 seventh : SV_Target6;
+    float4 eighth : SV_Target7;
+};
+Colors main(float4 position : SV_Position) {
+    float z = log2(max(abs(position.w), 1e-7));
+    float3 normal = normalize(float3(ddx(z) * 300.0, ddy(z) * 300.0, 1.0));
+    const float3 palette[6] = {
+        float3(0.88, 0.33, 0.16), float3(0.22, 0.72, 0.94),
+        float3(0.54, 0.37, 0.90), float3(0.30, 0.78, 0.49),
+        float3(0.95, 0.66, 0.22), float3(0.84, 0.40, 0.60)
+    };
+    float3 color = palette[MATERIAL] * (0.5 + 0.5 * saturate(dot(normal, normalize(float3(0.3, -0.6, 0.7)))));
+    Colors result;
+    result.first = result.second = result.third = result.fourth = float4(color, 1.0);
+    result.fifth = result.sixth = result.seventh = result.eighth = result.first;
+    return result;
+}
