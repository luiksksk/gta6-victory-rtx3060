+
+/// Optional loop bound for diagnostics. Keep a different cache key for each bound.
+pub fn loop_limit() -> u32 {
+    static LIMIT: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *LIMIT.get_or_init(|| std::env::var("VICTORY_SHADER_LOOP_LIMIT").ok()
+        .and_then(|v| v.parse().ok()).filter(|&n| n > 0 && n <= lower::LOOP_LIMIT)
+        .unwrap_or(lower::LOOP_LIMIT))
+}
