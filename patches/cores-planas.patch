diff --git a/crates/victory-gpu/build.rs b/crates/victory-gpu/build.rs
new file mode 100644
index 0000000000000000000000000000000000000000..69ac940816225bb6196acfa21365a1ab4e61ed94
--- /dev/null
+++ b/crates/victory-gpu/build.rs
@@ -0,0 +1,15 @@
+use std::{env, path::PathBuf, process::Command};
+
+fn main() {
+    println!("cargo:rerun-if-changed=src/pipeline/geometria.hlsl");
+    println!("cargo:rerun-if-env-changed=VICTORY_GEOMETRIA_DXC");
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("windows") { return; }
+    let compiler = env::var_os("VICTORY_GEOMETRIA_DXC").unwrap_or_else(|| "dxc.exe".into());
+    let output = PathBuf::from(env::var_os("OUT_DIR").expect("Cargo output directory"));
+    for material in 0..6 {
+        let status = Command::new(&compiler).args(["-E","main","-T","ps_6_0","-Ges","-WX","-D"])
+            .arg(format!("MATERIAL={material}")).arg("-Fo").arg(output.join(format!("geometry-{material}.dxil")))
+            .arg("src/pipeline/geometria.hlsl").status().expect("DXC do Windows SDK");
+        assert!(status.success(), "DXC não conseguiu compilar o shader de diagnóstico");
+    }
+}
