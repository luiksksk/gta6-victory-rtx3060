+/// Tries the split-wave compute lowering when the primary translator cannot
+/// represent a console wave on a 32-lane adapter. Both paths keep the
+/// original container and derive bindings from it.
+pub fn translate_for_adapter(container: &[u8], target: Target) -> Result<HostShader, String> {
+    let primary = match translate_for(container, target) {
+        Ok(shader) => return Ok(shader),
+        Err(ShaderError::Unsupported { offset, what })
+            if target.lanes_min == 32 && target.lanes_max == 32 && what.contains("wave64") =>
+            ShaderError::Unsupported { offset, what },
+        Err(error) => return Err(error.to_string()),
+    };
+    use wave32_translator::{HwStage as AlternateStage, RootType as AlternateRoot, emit as alternate};
+    let options = alternate::TranslateOptions { wave64: alternate::Wave64Mode::Wave32 };
+    let shader = alternate::translate_with(container, options)
+        .map_err(|error| format!("{primary}; split Wave64: {error}"))?;
+    if shader.stage != AlternateStage::Cs {
+        return Err(primary.to_string());
+    }
+    let user_data = shader.user_data.into_iter().map(|u| UserData {
+        index: u.index, slot: u.slot, dword: u.dword,
+        root: match u.root {
+            AlternateRoot::Constants => RootType::Constants,
+            AlternateRoot::Descriptor => RootType::Descriptor,
+            AlternateRoot::Table => RootType::Table,
+            AlternateRoot::ImmediateSampler => RootType::ImmediateSampler,
+            AlternateRoot::ResourceHeap => RootType::ResourceHeap,
+            AlternateRoot::SamplerHeap => RootType::SamplerHeap,
+            AlternateRoot::Other(value) => RootType::Other(value),
+        },
+    }).collect();
+    Ok(HostShader {
+        stage: HwStage::Cs, dxil: shader.dxil, user_data,
+        static_samplers: shader.samplers.iter().copied().map(StaticSampler::from_words).collect(),
+        samplers: shader.samplers, root_cbvs: shader.root_cbvs, root_srvs: shader.root_srvs,
+        // This version of the split-wave emitter never declares a stride table.
+        stride_table: false,
+    })
+}
